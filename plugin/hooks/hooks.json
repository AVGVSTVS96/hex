{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/wake 1" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/wake 2" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/wake 3" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/wake 4" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/wake 5" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/wake 6 last" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/live-status" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/chat begin" }
      ] },
      { "matcher": "compact", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/compacted memory" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/compacted turns" }
      ] },
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/rules" },
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/tasks.ts" }
      ] }
    ],
    "SubagentStart": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/instructions 1" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/instructions 2" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/instructions 3" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/instructions 4" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/instructions 5" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/instructions 6 last" }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "mcp__claude_ai_.*", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/send-gate" }] },
      { "matcher": "^(Edit|Write|MultiEdit)$", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/budget" }] }
    ],
    "PostToolUse": [
      { "matcher": "^Bash$", "hooks": [{ "type": "command", "if": "Bash(*.md*)", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/budget" }] },
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/log new", "async": true }] },
      { "matcher": "mcp__t3.code__t3_thread_(send|launch)", "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/relayed.ts", "async": true }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/state.ts busy" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/rules" },
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/tasks.ts" }
      ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/state.ts idle" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/log" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/chat log" },
        { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/observe.ts" }
      ] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}\"/../hub/state.ts idle" }] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/log" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/../bin/ended" }
      ] }
    ]
  }
}
