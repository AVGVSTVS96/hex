[Unit]
Description=hex: the hub, which keeps General running and starts a session per thread

[Service]
# Active once the hub, which bin/hex starts, has started polling Telegram, or started ahead (HEX_AHEAD), is ready to take over.
# Until then it stays activating, however long the hub keeps trying.
Type=notify
NotifyAccess=all
TimeoutStartSec=infinity
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=HEX_SESSIONS_SLICE=hex-sessions.slice
ExecStart=%h/hex/.hex/bin/hex run
Restart=always
RestartSec=3
# A hex that keeps failing waits longer between tries, so the unit shows as down, not active, until it starts.
RestartSteps=5
RestartMaxDelaySec=1min
# A stop waits for a live call to end, the way a restart does.
TimeoutStopSec=30min
MemoryMax=2G
# The hub answers every channel, so it runs ahead of everything else on the machine when the CPU or disk is short
# (session.slice.d/hex.conf).
Slice=session.slice
CPUWeight=1000
OOMPolicy=continue

[Install]
WantedBy=default.target
