[Unit]
Description=hex: the hub, which keeps General running and starts a session per thread

[Service]
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=HEX_SESSIONS_SLICE=hex-sessions.slice
ExecStart=%h/hex/.hex/bin/hex run
Restart=always
RestartSec=3
# A stop waits for a live call to end, the way a restart does.
TimeoutStopSec=30min
MemoryMax=2G
# The hub answers every channel, so it runs ahead of the sessions and builds it starts when the CPU or memory is short.
CPUWeight=1000
MemoryLow=1G
OOMPolicy=continue

[Install]
WantedBy=default.target
