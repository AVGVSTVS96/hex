#!/usr/bin/env python3
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import datetime
from html import unescape
from pathlib import Path

CHANNEL = re.compile(r'<channel\s([^>]*)>([\s\S]*?)</channel>')
ATTR = re.compile(r'(\w+)="([^"]*)"')
EVENTS = ("reaction", "reaction_removed", "deleted", "vote", "vote_removed", "button")


def his_messages(prompt):
    for tag, body in CHANNEL.findall(prompt):
        meta = {k: unescape(v) for k, v in ATTR.findall(tag)}
        text = " ".join(body.split())
        if meta.get("user_id") and text and not any(e in meta for e in EVENTS):
            yield meta, text


def claim(home, meta, text):
    seen = home / "state" / "verbatim"
    seen.mkdir(parents=True, exist_ok=True)
    key = "\0".join([meta.get("source", ""), meta.get("chat_id", ""), meta.get("message_id", ""), text])
    mark = seen / hashlib.sha1(key.encode()).hexdigest()[:20]
    try:
        os.close(os.open(mark, os.O_CREAT | os.O_EXCL))
        return mark
    except FileExistsError:
        return None


def thread_name(home, app):
    if os.environ.get("HEX_MAIN"):
        return "General"
    try:
        return json.loads((home / "state" / app / "threads.json").read_text())[os.environ["HEX_THREAD"]]["name"]
    except (OSError, ValueError, KeyError):
        return ""


def log_file(hook):
    started = datetime.now()
    try:
        with open(hook["transcript_path"]) as transcript:
            for line in transcript:
                stamp = json.loads(line).get("timestamp")
                if stamp:
                    started = datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone()
                    break
    except (OSError, KeyError, ValueError):
        pass
    folder = "log/threads" if os.environ.get("HEX_THREAD") and not os.environ.get("HEX_MAIN") else "log"
    return f"{folder}/{started:%Y-%m-%d}-{hook.get('session_id', '')[:8]}.md"


def fit(text, room):
    if len(text.encode()) <= room:
        return text
    cut = text.encode()[:room - len("…".encode())].decode(errors="ignore")
    word = cut.rsplit(" ", 1)[0]
    return (word if len(word) > len(cut) * 0.8 else cut).rstrip() + "…"


def main():
    hook = json.load(sys.stdin)
    memo = Path(__file__).resolve().parent.parent / "vendor" / "memo"
    if os.environ.get("HEX_VERBATIM") != "1" or not os.environ.get("MEMORY_DIR") or not memo.exists():
        return
    home = Path(os.environ.get("CLAUDE_PROJECT_DIR") or hook.get("cwd") or ".")
    config = subprocess.run([memo, "config"], capture_output=True, text=True).stdout
    limit = int(re.search(r"^ENTRY_CHARS\s+(\d+)", config, re.M)[1])

    for meta, text in his_messages(hook.get("prompt", "")):
        mark = claim(home, meta, text)
        if not mark:
            continue
        app = re.sub(r"^plugin:|:.*$", "", meta.get("source", "chat"))
        where = " ".join(filter(None, [app, thread_name(home, app)]))
        sent = datetime.fromisoformat(meta["ts"].replace("Z", "+00:00")).astimezone() if meta.get("ts") else datetime.now()
        message = f" #{meta['message_id'][:12]}" if meta.get("message_id") else ""
        suffix = f" — Bassim, {where}, {sent:%Y-%m-%d %H:%M}, {log_file(hook)}{message}"
        if subprocess.run([memo, "note", fit(text, limit - len(suffix.encode())) + suffix], capture_output=True).returncode:
            mark.unlink()


main()
