#!/bin/sh
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
pidfile="$home/state/hub.pid"

running() {
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# A service manager starts hex with a bare PATH, so hex takes the one the user's own shell builds,
# rc files included, and sessions and jobs find what a terminal finds. A shell that hangs or fails leaves PATH as it is.
shell_path() {
  limit=
  ! command -v timeout >/dev/null || limit="timeout 10"
  found=$($limit "${SHELL:-/bin/sh}" -ilc 'echo; echo hex-path; env' </dev/null 2>/dev/null | sed -n '/^hex-path$/,$s/^PATH=//p' | tail -n 1) || :
  [ -z "$found" ] || PATH=$(printf '%s:%s' "$found" "$PATH" | tr : '\n' | awk 'NF && !seen[$0]++' | paste -sd: -)
}

# A hub that exits three times within a minute can't start. If hex changed since General last
# connected (the hub writes that commit to state/good), hex goes back to it, bin/update won't take
# the commit that failed (state/bad) again, and General hears why once it's back. Fails when there's
# nothing to go back to.
roll_back() {
  good=$(cat "$home/state/good" 2>/dev/null) || return 1
  bad=$(git -C "$hex" rev-parse HEAD)
  [ -n "$good" ] && [ "$good" != "$bad" ] && git -C "$hex" reset -q --keep "$good" || return 1
  echo "$bad" > "$home/state/bad"
  note="hex $(git -C "$hex" log -1 --format='%h ("%s")' "$bad") couldn't start: its hub exited three times within a minute. So hex went back to $(git -C "$hex" log -1 --format='%h ("%s")' "$good"), the last commit General connected on, and bin/update won't take $(git -C "$hex" rev-parse --short "$bad") again. What the failed starts printed is in the hub's log (state/hub.log, or the journal of the unit that runs hex)."
  echo "$note" >&2
  echo "$note" > "$home/state/rollback"
}

managed=/etc/claude-code/managed-settings.json
[ "$(uname)" = Darwin ] && managed="/Library/Application Support/ClaudeCode/managed-settings.json"
managed=${HEX_MANAGED_SETTINGS:-$managed}
units_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
systemd() { systemctl --user show-environment >/dev/null 2>&1; }

# What a machine needs to run hex: hex's own services.json, then the owner's, in their hex folder.
lists() { echo "$hex/services.json"; [ ! -f "$home/services.json" ] || echo "$home/services.json"; }

# A thing a list installs: a command on PATH, or a path.
there() {
  case $1 in
    "~/"*) [ -e "$HOME/${1#"~/"}" ] ;;
    */*) [ -e "$1" ] ;;
    *) command -v "$1" >/dev/null ;;
  esac
}

# The unit files the lists name (or the one list given), quoted for `eval set --`. A list's paths start from its own folder, or from home with ~/.
units() {
  for list in ${1:-$(lists)}; do
    jq -r --arg dir "$(dirname "$list")/" --arg home "$HOME/" \
      '.units // [] | map(if startswith("/") then . elif startswith("~/") then $home + .[2:] else $dir + . end) | @sh' "$list"
  done | tr '\n' ' '
}

# Where a unit file is linked: a drop-in, in a folder named for its unit (<unit>.d), goes in a real folder of that name.
link_of() {
  case $(basename "$(dirname "$1")") in
    *.d) echo "$units_dir/$(basename "$(dirname "$1")")/$(basename "$1")" ;;
    *) echo "$units_dir/$(basename "$1")" ;;
  esac
}

# The channels hex ships with a server of their own, for Claude Code's managed settings to allow.
channels() { for mcp in "$hex"/channels/*/.mcp.json; do basename "$(dirname "$mcp")"; done; }

# hex that can't start tells General itself, straight through Telegram, since no hub runs to send it. Once per
# machine, until a hub connects there again (state/down.<host>) and says it's back.
down() {
  echo "$1" >&2
  marker="$home/state/down.$(uname -n)"
  [ ! -e "$marker" ] || return 0
  (
    set +eu
    . "$hex/bin/settings"
    [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${HEX_MAIN_THREAD:-}" ] &&
      printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TELEGRAM_BOT_TOKEN" |
      curl -sf -m 10 -o /dev/null -K - --data-urlencode "chat_id=$HEX_MAIN_THREAD" --data-urlencode "text=$1 General hears here once it's back."
  ) && date +%s > "$marker" || :
}

case "${1:-}" in
  init)
    for file in AGENTS.md SOUL.md PROACTIVE.md schedules.json; do
      [ -e "$home/$file" ] || cp "$hex/defaults/$file" "$home/$file"
    done
    [ -e "$home/.gitignore" ] || cp "$hex/defaults/gitignore" "$home/.gitignore"
    [ -e "$home/.env" ] || (umask 077 && cp "$hex/defaults/env" "$home/.env")
    mkdir -p "$home/.claude" "$home/state/telegram" "$home/state/discord" "$home/state/buzz" "$home/state/t3"
    [ -e "$home/.claude/settings.json" ] || jq --arg memory "$home/memory" '.env.MEMORY_DIR = $memory' "$hex/defaults/settings.json" > "$home/.claude/settings.json"
    # Claude Code runs a background session in bypassPermissions only with consent in the user's own settings.
    if [ "$(jq -r '.permissions.defaultMode' "$home/.claude/settings.json")" = bypassPermissions ]; then
      user="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
      if ! grep -q '[^[:space:]]' "$user" 2>/dev/null; then
        mkdir -p "$(dirname "$user")"
        echo '{ "skipDangerousModePermissionPrompt": true }' > "$user"
      elif ! jq -e '.skipDangerousModePermissionPrompt == true' "$user" >/dev/null 2>&1; then
        consent=$(jq '.skipDangerousModePermissionPrompt = true' "$user") || { echo "$user isn't valid JSON: add \"skipDangerousModePermissionPrompt\": true to it, then run init again" >&2; exit 1; }
        printf '%s\n' "$consent" > "$user"
      fi
    fi
    "$hex/bin/optmem"
    MEMORY_DIR="$home/memory" "$hex/vendor/memo" init >/dev/null
    (. "$hex/bin/settings"; export HEX_STORE="$home/state"; wake) || :
    chmod 700 "$home" "$home/state"
    # Before the HEAD check, so a folder inside another repo (a dotfiles repo at $HOME) gets its own.
    git -C "$home" init -q
    if ! git -C "$home" rev-parse -q --verify HEAD >/dev/null 2>&1; then
      git -C "$home" add -A
      # A fresh machine has no git identity, which would fail the first commit.
      identity=
      { git -C "$home" var GIT_AUTHOR_IDENT && git -C "$home" var GIT_COMMITTER_IDENT; } >/dev/null 2>&1 || identity="-c user.name=hex -c user.email=hex@localhost"
      git -C "$home" $identity commit -qm "chore: a new hex"
    fi
    echo "hex is set up in $home"
    ;;
  run)
    shell_path
    # In a shell of its own, so a line of .env that fails stops the check the way it would stop the hub. Only where it
    # failed is told, since the shell's error quotes the line, which may be a secret.
    home="$home" sh -eu -c '. "$1"; [ -n "${TELEGRAM_BOT_TOKEN:-}" ]' sh "$hex/bin/settings" || {
      line=$([ ! -f "$home/.env" ] || sh -eu -c 'set -a; . "$1"' sh "$home/.env" 2>&1 >/dev/null | sed -n 's/^[^:]*: \(line \)*\([0-9][0-9]*\):.*/\2/p' | head -n 1)
      if [ -n "$line" ]; then why="line $line of $home/.env fails as a command"; else why="$home/.env sets no TELEGRAM_BOT_TOKEN"; fi
      down "hex can't start on $(uname -n): $why."
      exit 1
    }
    export HEX_DIR="$home" HEX_LAUNCHER="$hex/bin/session" HEX_NAME="${HEX_NAME:-hex}"
    # The hex whose plugin and launcher sessions start from: a change to what they read only at start renews them at their next rest.
    export HEX_STARTUP="$hex"
    export TELEGRAM_STATE_DIR="$home/state/telegram" DISCORD_STATE_DIR="$home/state/discord" BUZZ_STATE_DIR="$home/state/buzz" T3_STATE_DIR="$home/state/t3"
    # A stop ends the hub the way a restart does, once no call is live, and waits for it to exit.
    trap '[ -z "${hub:-}" ] || { kill -TERM "$hub" 2>/dev/null; wait "$hub"; }; rm -f "$pidfile"; exit 0' INT TERM
    start() {
      bun install --no-summary --cwd "$hex" >/dev/null || :
      # Read at every start, so a restart takes the settings as they are now.
      (. "$hex/bin/settings"; exec bun "$hex/hub/serve.ts") &
      hub=$!
    }
    # Started ahead of its turn, while hex still runs on another machine that's handing it over, the hub gets ready and
    # waits (hub/ahead.ts), and so does the rest of hex here, until the file HEX_AHEAD names is gone.
    start
    [ -z "${HEX_AHEAD:-}" ] || bun "$hex/hub/ahead.ts" "$HEX_AHEAD"
    echo $$ > "$pidfile"
    # Apps following hex with `hex watch` read it again as it starts, as after a restore of hex.db.
    printf . >> "$home/state/hex.bell"
    first= second= third=
    while :; do
      [ -n "$hub" ] || start
      # Jobs a move or their machine going down stopped carry on, alongside each start of the hub, so a pass that failed
      # is tried again; one whose unit runs is left alone.
      (. "$hex/bin/settings"; bun "$hex/bin/job" --resume || echo "hex: jobs that were stopped didn't resume; the hub's next start tries again" >&2) &
      if wait "$hub"; then
        hub=
        # A restart: go on as the bin/hex on disk now, which an update may have changed.
        sh -n "$hex/bin/hex" && exec "$hex/bin/hex" run
        continue
      fi
      hub=
      first=$second second=$third third=$(date +%s)
      if [ -n "$first" ] && [ $((third - first)) -le 60 ]; then
        # With nothing to go back to, hex stops as failed, for its service manager to see and act on.
        roll_back || { down "hex can't start on $(uname -n): its hub exited three times within a minute, and there's no earlier hex to go back to. What it printed is in the hub's log (state/hub.log, or the journal of the unit that runs hex)."; rm -f "$pidfile"; exit 1; }
        first= second= third=
      fi
      sleep 3
    done
    ;;
  start)
    running && exit 0
    nohup "$0" run >> "$home/state/hub.log" 2>&1 &
    echo "hex started; its log is state/hub.log"
    ;;
  stop)
    running || exit 0
    pid=$(cat "$pidfile")
    kill "$pid"
    # The hub finishes a live call first; whatever starts hex next waits for it to be gone.
    while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done
    ;;
  restart)
    running && pkill -HUP -P "$(cat "$pidfile")" -f hub/serve.ts || "$0" start
    ;;
  acp)
    exec bun "$hex/channels/t3/acp.ts" "$home/state/t3/acp.sock"
    ;;
  deliver|task|tasks|hold|holds|questions|pins|threads|thread|running|message|profile|log|recall|watch)
    export MEMORY_DIR="${MEMORY_DIR:-$home/memory}"
    exec bun "$hex/hub/cli.ts" "$home/state" "$@"
    ;;
  status)
    if running; then echo "hub: running (pid $(cat "$pidfile"))"; else echo "hub: stopped"; fi
    bun "$hex/hub/cli.ts" "$home/state" running || echo "sessions: hex running failed"
    units=$(systemctl --user list-units --type=service --state=running --no-legend --plain 2>/dev/null | awk '{print $1}')
    if [ -n "$units" ]; then
      systemctl --user show $units -p Id,ActiveEnterTimestamp,ExecStopPost 2>/dev/null | awk -F= -v job=" $(cd "$hex" && pwd -P)/bin/job --ended " '
        function done() { if (ours) print "job " substr(id, 1, length(id) - 8) ": running since " since; ours = 0 }
        /^$/ { done() } /^Id=/ { id = $2 } /^ActiveEnterTimestamp=/ { since = $2 } /^ExecStopPost=/ && index($0, job) { ours = 1 }
        END { done() }'
    fi
    ;;
  restore)
    PATH=$HOME/.local/bin:$HOME/.bun/bin:$PATH
    missing=
    for tool in git curl jq python3; do command -v "$tool" >/dev/null || missing="$missing $tool"; done
    [ -z "$missing" ] || { echo "restore: install$missing with the system's package manager first (INSTALL.md step 1)" >&2; exit 1; }
    # Each thing a list installs is made by its line when it's missing.
    for list in $(lists); do
      cd "$(dirname "$list")"
      eval "set -- $(jq -r '.install // {} | to_entries | map(.key, .value) | @sh' "$list")"
      while [ $# -gt 0 ]; do
        need=$1 how=$2
        shift 2
        there "$need" && continue
        echo "installing $need"
        sh -c "$how" </dev/null && there "$need" || { echo "restore: \`$how\` didn't make $need" >&2; exit 1; }
      done
    done
    cd "$home"
    bun install --no-summary --cwd "$hex" >/dev/null
    "$hex/bin/hex" init >/dev/null
    # hex turns each channel on in its own sessions only, so it's installed turned off.
    marketplace=$(claude plugin marketplace list --json | jq -r '.[] | select(.name == "hex") | .path // "elsewhere"')
    if ! [ "$marketplace" -ef "$hex/channels" ]; then
      # One brought over from another machine points at its hex.
      [ -z "$marketplace" ] || claude plugin marketplace remove hex >/dev/null
      claude plugin marketplace add "$hex/channels" >/dev/null
    fi
    installed=$(claude plugin list --json)
    for channel in $(channels); do
      printf '%s\n' "$installed" | jq -e --arg id "$channel@hex" 'any(.[]; .id == $id)' >/dev/null && continue
      claude plugin install "$channel@hex" >/dev/null && claude plugin disable "$channel@hex" >/dev/null || { echo "restore: the $channel channel didn't install" >&2; exit 1; }
      echo "installed the $channel channel"
    done
    # Claude Code's managed settings: what's there, with the lists' own, and every channel of hex allowed.
    current=$(cat "$managed" 2>/dev/null) || current='{}'
    allowed=$(channels | jq -R '{ plugin: ., marketplace: "hex" }' | jq -s .)
    wanted=$(lists | xargs jq -s --argjson current "$current" --argjson allowed "$allowed" '
      . as $lists
      | reduce $lists[] as $list ($current; . * ($list.managed // {}))
      | .channelsEnabled = true
      | .allowedChannelPlugins = (([$current, $lists[].managed] | map(.allowedChannelPlugins // []) | add) + $allowed | unique)')
    if [ "$(printf '%s' "$wanted" | jq -S .)" != "$(printf '%s' "$current" | jq -S '.allowedChannelPlugins |= (. // [] | unique)')" ]; then
      printf '%s\n' "$wanted" | sudo sh -c 'mkdir -p "$(dirname "$1")" && cat > "$1"' sh "$managed"
      echo "wrote $managed"
    fi
    "$hex/bin/trust" "$home"
    if systemd; then
      enable=
      eval "set -- $(units)"
      for file; do
        [ -f "$file" ] || { echo "restore: there's no unit file at $file" >&2; exit 1; }
        link=$(link_of "$file")
        if ! [ "$link" -ef "$file" ]; then
          # A file of the machine's own in its place gives way only when it says the same.
          [ ! -f "$link" ] || [ -L "$link" ] || [ "$(cat "$link")" = "$(cat "$file")" ] || { echo "restore: $link is a file of this machine's own, unlike $file: move it away and run restore again" >&2; exit 1; }
          mkdir -p "$(dirname "$link")"
          ln -sfn "$file" "$link"
        fi
        [ "$link" != "$units_dir/$(basename "$file")" ] || ! grep -q '^\[Install\]' "$file" || enable="$enable $(basename "$file")"
      done
      # hex.service runs ~/hex; a folder elsewhere gets a drop-in that runs it instead.
      if [ "$hex" != "$HOME/hex/.hex" ]; then
        mkdir -p "$units_dir/hex.service.d"
        printf '[Service]\nExecStart=\nExecStart="%s/bin/hex" run\n' "$hex" > "$units_dir/hex.service.d/folder.conf"
      else
        rm -f "$units_dir/hex.service.d/folder.conf"
      fi
      systemctl --user daemon-reload
      # A hub started by hand gives way to its unit.
      systemctl --user -q is-active hex.service || "$hex/bin/hex" stop
      # A unit that won't start is doctor's to report.
      systemctl --user enable --now $enable || :
      # Services keep running once the user logs out, and start as the machine boots.
      user=$(id -un)
      [ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null)" = yes ] || loginctl enable-linger "$user" 2>/dev/null || sudo loginctl enable-linger "$user" || :
      starting() { systemctl --user is-active hex.service | grep -Eqx 'active|activating'; }
    else
      set --
      [ ! -f "$home/services.json" ] || eval "set -- $(units "$home/services.json")"
      names=$(for file; do basename "$file"; done | paste -sd' ' -)
      echo "no systemd user manager here, so hex runs on its own${names:+, and your units don't run: $names}; have the machine start hex as it boots (INSTALL.md step 5)"
      "$hex/bin/hex" start
      starting() { :; }
    fi
    # The hub writes its pid as it starts.
    tries=0
    while ! running && [ $((tries += 1)) -le 30 ] && starting; do sleep 1; done
    exec "$hex/bin/hex" doctor
    ;;
  doctor)
    shell_path
    problems=0
    ok() { echo "ok   $1"; }
    fix() { echo "fix  $1"; problems=$((problems + 1)); }
    for tool in git curl jq python3 bun claude; do
      command -v "$tool" >/dev/null && ok "$tool" || fix "$tool isn't on PATH (INSTALL.md step 1)"
    done
    if command -v claude >/dev/null && command -v jq >/dev/null; then
      days=$(claude auth status 2>/dev/null | jq -r 'select(.loggedIn) | (.loginExpiresAt // empty | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 - now) / 86400 | floor') || days=
      if ! claude auth status 2>/dev/null | jq -e .loggedIn >/dev/null; then
        fix "Claude Code isn't signed in: run \`claude auth login\`"
      elif [ -n "$days" ] && [ "$days" -lt 3 ]; then
        fix "Claude sign-in ends in $days days: run \`claude auth login\` before then"
      else
        ok "Claude signed in${days:+, for $days more days}"
      fi
      [ "$(jq -r --arg home "$home" '.projects[$home].hasTrustDialogAccepted' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" 2>/dev/null)" = true ] \
        && ok "$home is trusted" || fix "$home isn't trusted: run \`$hex/bin/hex restore\`"
      plugins=$(claude plugin list --json 2>/dev/null) || plugins='[]'
    fi
    (. "$hex/bin/settings"; [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && curl -sf -m 10 "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getMe" >/dev/null) \
      && ok "Telegram bot token works" || fix "TELEGRAM_BOT_TOKEN in $home/.env is missing or Telegram rejects it (INSTALL.md steps 3-4)"
    (. "$hex/bin/settings"; [ -n "${HEX_MAIN_THREAD:-}" ]) && ok "HEX_MAIN_THREAD is set" || fix "HEX_MAIN_THREAD isn't set in $home/.env (INSTALL.md step 4)"
    jq -e '.allowFrom | length > 0' "$home/state/telegram/access.json" >/dev/null 2>&1 \
      && ok "Telegram access list" || fix "nobody may talk to hex: write $home/state/telegram/access.json (INSTALL.md step 4)"
    for channel in $(channels); do
      printf '%s\n' "${plugins:-[]}" | jq -e --arg id "$channel@hex" 'any(.[]; .id == $id)' >/dev/null || continue
      jq -e --arg plugin "$channel" '.channelsEnabled == true and any(.allowedChannelPlugins[]?; .plugin == $plugin and .marketplace == "hex")' "$managed" >/dev/null 2>&1 \
        && ok "$channel channel installed and allowed" || fix "$managed doesn't allow the $channel@hex channel: run \`$hex/bin/hex restore\`"
    done
    printf '%s\n' "${plugins:-[]}" | jq -e 'any(.[]; .id == "telegram@hex")' >/dev/null || fix "the Telegram channel isn't installed: run \`$hex/bin/hex restore\`"
    [ -d "$home/memory" ] && ok "memory in $home/memory" || fix "no memory folder: run \`$hex/bin/hex init\`"
    if systemd; then
      before=$problems
      eval "set -- $(units)"
      for file; do
        link=$(link_of "$file") name=$(basename "$file")
        if ! [ "$link" -ef "$file" ]; then
          fix "$name isn't linked from $file: run \`$hex/bin/hex restore\`"
        elif [ "$link" = "$units_dir/$name" ] && { systemctl --user -q is-failed "$name" || [ "$(systemctl --user show -p SubState --value "$name")" = auto-restart ]; }; then
          fix "$name failed: see \`journalctl --user -u $name\`"
        fi
      done
      [ "$problems" -gt "$before" ] || ok "$# unit files linked, none failed"
      [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" = yes ] && ok "services run while you're logged out" \
        || fix "services stop when you log out: run \`sudo loginctl enable-linger $(id -un)\`"
    fi
    if running; then
      ok "hub running (pid $(cat "$pidfile"))"
    elif systemd && [ "$(systemctl --user show -p Result --value hex.service)" = exec-condition ]; then
      ok "hub waits: hex.service's ExecCondition keeps it off this machine"
    else
      fix "the hub isn't running: run \`$hex/bin/hex restore\`"
    fi
    free=$(df -Pk "$home" | awk 'NR == 2 { print int($4 / 1048576) }')
    [ "${free:-0}" -ge 5 ] && ok "$free GB free on disk" || fix "only ${free:-0} GB free on disk: sessions and backups need room"
    [ "$problems" -eq 0 ] && echo "hex looks healthy" || { echo "$problems to fix"; exit 1; }
    ;;
  *)
    echo "usage: hex init|restore|start|stop|restart|status|doctor|run|acp|deliver|task|tasks|hold|holds|questions|pins|threads|thread|running|message|profile|log|recall|watch" >&2
    exit 2
    ;;
esac
