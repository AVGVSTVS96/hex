#!/bin/sh
cd "$(dirname "$0")/.." || exit 1
set -a; . ./.env; set +a

claude agents --json | jq -e '.[] | select(.name == "hex" and .pid)' >/dev/null && exit 0

exec claude --bg --name hex \
  --channels plugin:telegram@hex \
  --plugin-dir mods/scheduler \
  --settings "$(jq --arg thread "$HEX_MAIN_THREAD" --arg hub "$HOME/.claude/channels/hex/telegram/hub.sock" \
    '.env = { HEX_THREAD: $thread, HEX_HUB: $hub }' .claude/main.json)"
