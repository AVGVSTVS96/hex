#!/bin/sh
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
pidfile="$home/state/hub.pid"

# Whatever moves hex to another machine says so in this machine's own state, for the jobs it leaves here: the file is
# empty while hex moves, then names the machine hex runs on. elsewhere prints that machine once the move is done, and
# fails with 1 while hex runs here, or 2 if it's still moving after a minute. A file naming this machine means here.
marker=${XDG_STATE_HOME:-$HOME/.local/state}/hex/elsewhere
elsewhere() {
  waited=0
  while [ -e "$marker" ]; do
    where=$(cat "$marker" 2>/dev/null) || where=
    [ "$where" != "$(uname -n)" ] || return 1
    [ -z "$where" ] || { echo "$where"; return 0; }
    [ "$waited" -lt 120 ] || return 2
    sleep 0.5
    waited=$((waited + 1))
  done
  return 1
}

running() {
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# store.json names the Durable Object that holds hex's records, when one does. said prints what the object named on its
# stdin says of itself, and answers the version of the store code it runs; each fails when it doesn't answer. The key
# goes to curl on stdin, out of ps.
store="$home/state/store.json"
# Pinned, so one commit builds to one version wherever it deploys.
wrangler="bunx wrangler@4.164.0"
said() {
  jq -r '"url = \"\(.url | rtrimstr("/"))/\(.name)/version\"", "header = \"authorization: Bearer \(.key)\""' |
    curl -sf -m 10 -K -
}
answers() { said | jq -er '.version | strings'; }

# A service manager starts hex with a bare PATH, so hex takes the one the user's own shell builds,
# rc files included, and sessions and jobs find what a terminal finds. A shell that hangs or fails leaves PATH as it is.
shell_path() {
  limit=
  ! command -v timeout >/dev/null || limit="timeout 10"
  found=$($limit "${SHELL:-/bin/sh}" -ilc 'echo; echo hex-path; env' </dev/null 2>/dev/null | sed -n '/^hex-path$/,$s/^PATH=//p' | tail -n 1) || :
  [ -z "$found" ] || PATH=$(printf '%s:%s' "$found" "$PATH" | tr : '\n' | awk 'NF && !seen[$0]++' | paste -sd: -)
}

described() { git -C "$hex" log -1 --format='%h ("%s")' "$1"; }

# Whether bin/update, or a machine taking hex over, leaves a commit, and why: one hex rollback went back from, here
# (state/refused) or on any machine whose hub told the store, or the one an automatic rollback left on this machine
# (state/bad). Each line of the first is the newest commit refused, then the one hex went back to: every commit after
# that one, up to the newest, is refused. Where the newest isn't here, every commit after the one gone back to is, since
# none here can be past a commit this machine doesn't have.
refused() {
  sha=$(git -C "$hex" rev-parse -q --verify "$1^{commit}") || return 1
  { cat "$home/state/refused" 2>/dev/null || :; [ ! -e "$store" ] || said < "$store" | jq -r '.refused // [] | .[]' 2>/dev/null || :; } |
    while read -r newest to; do
      [ "$sha" != "$to" ] && git -C "$hex" merge-base --is-ancestor "$to" "$sha" 2>/dev/null || continue
      ! git -C "$hex" cat-file -e "$newest^{commit}" 2>/dev/null || git -C "$hex" merge-base --is-ancestor "$sha" "$newest" || continue
      echo "hex rollback went back from $(git -C "$hex" rev-parse --short "$sha"), or from a commit it's built on"
      break
    done | grep . && return
  [ "$(cat "$home/state/bad" 2>/dev/null)" = "$sha" ] && echo "hex $(git -C "$hex" rev-parse --short "$sha") couldn't start here"
}

# A hub that exits three times within a minute can't start. If hex changed since General last
# connected (the hub writes that commit to state/good), hex goes back to it, bin/update won't take
# the commit that failed (state/bad) again, and General hears why once it's back. Only ever back, so a commit hex
# rollback went back from, which state/good may still name, never runs again this way; and on this machine alone, since
# a hub may fail for the machine's own reasons. Fails when there's nothing to go back to.
roll_back() {
  good=$(cat "$home/state/good" 2>/dev/null) || return 1
  bad=$(git -C "$hex" rev-parse HEAD)
  [ -n "$good" ] && [ "$good" != "$bad" ] && git -C "$hex" merge-base --is-ancestor "$good" "$bad" && git -C "$hex" reset -q --keep "$good" || return 1
  echo "$bad" > "$home/state/bad"
  note="hex $(git -C "$hex" log -1 --format='%h ("%s")' "$bad") couldn't start: its hub exited three times within a minute. So hex went back to $(git -C "$hex" log -1 --format='%h ("%s")' "$good"), the last commit General connected on, and bin/update won't take $(git -C "$hex" rev-parse --short "$bad") again. What the failed starts printed is in the hub's log (state/hub.log, or the journal of the unit that runs hex)."
  echo "$note" >&2
  echo "$note" > "$home/state/rollback"
}

# While hex runs on another machine, a command runs there, as whoever ran it here.
where_hex_runs() {
  moved=0
  where=$(elsewhere) || moved=$?
  [ "$moved" != 2 ] || { echo "hex is moving between machines; try again in a minute" >&2; exit 1; }
  [ "$moved" = 0 ] || return 0
  set -- "$hex/bin/hex" "$@"
  for name in HEX_OWNER HEX_THREAD HEX_CHANNEL HEX_MAIN HEX_BESIDE HEX_HELPER; do
    eval "value=\${$name:-}"
    [ -z "$value" ] || set -- "$name=$value" "$@"
  done
  exec ssh -o BatchMode=yes -o ConnectTimeout=5 "$where" "bash -c 'mapfile -d \"\" -t a < <(printf %s $(printf '%s\0' "$@" | base64 -w0) | base64 -d); exec env \"\${a[@]}\"'"
}

managed=/etc/claude-code/managed-settings.json
[ "$(uname)" = Darwin ] && managed="/Library/Application Support/ClaudeCode/managed-settings.json"
managed=${HEX_MANAGED_SETTINGS:-$managed}
units_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
systemd() { systemctl --user show-environment >/dev/null 2>&1; }
# hex.service runs this folder's hex: a stop or a start goes through it, so systemd neither brings hex back after a
# stop nor runs a second beside one started by hand.
own_unit() { systemd && systemctl --user show -p ExecStart --value hex.service 2>/dev/null | grep -qF "$hex/bin/hex run"; }
# A machine whose systemd has oomd, with it off.
oomd_off() { systemctl cat systemd-oomd.service >/dev/null 2>&1 && ! systemctl is-active -q systemd-oomd.service; }

# What a machine needs to run hex: hex's own services.json, then the owner's, in their hex folder.
lists() { echo "$hex/services.json"; [ ! -f "$home/services.json" ] || echo "$home/services.json"; }

# A thing a list installs: a command on PATH, or a path.
there() {
  case $1 in
    "~/"*) [ -e "$HOME/${1#"~/"}" ] ;;
    */*) [ -e "$1" ] ;;
    *) command -v "$1" >/dev/null ;;
  esac
}

# The unit files the lists name (or the one list given), quoted for `eval set --`. A list's paths start from its own folder, or from home with ~/.
units() {
  for list in ${1:-$(lists)}; do
    jq -r --arg dir "$(dirname "$list")/" --arg home "$HOME/" \
      '.units // [] | map(if startswith("/") then . elif startswith("~/") then $home + .[2:] else $dir + . end) | @sh' "$list"
  done | tr '\n' ' '
}

# Where a unit file is linked: a drop-in, in a folder named for its unit (<unit>.d), goes in a real folder of that name.
link_of() {
  case $(basename "$(dirname "$1")") in
    *.d) echo "$units_dir/$(basename "$(dirname "$1")")/$(basename "$1")" ;;
    *) echo "$units_dir/$(basename "$1")" ;;
  esac
}

# Whether a unit file is linked where systemd reads it: systemd skips a drop-in folder that's a link (stow folds one into a link to its repo).
linked() { [ "$1" -ef "$2" ] && { [ "$(dirname "$1")" = "$units_dir" ] || [ ! -L "$(dirname "$1")" ]; }; }

# Links every unit file the lists name where systemd reads it, and puts in enable the units to enable.
link_units() {
  enable=
  eval "set -- $(units)"
  for file; do
    [ -f "$file" ] || { echo "restore: there's no unit file at $file" >&2; exit 1; }
    link=$(link_of "$file")
    if ! linked "$link" "$file"; then
      # The link would land in the repo a linked drop-in folder points at.
      [ "$(dirname "$link")" = "$units_dir" ] || [ ! -L "$(dirname "$link")" ] || rm "$(dirname "$link")"
      # A file of the machine's own in its place gives way only when it says the same.
      [ ! -f "$link" ] || [ -L "$link" ] || [ "$(cat "$link")" = "$(cat "$file")" ] || { echo "restore: $link is a file of this machine's own, unlike $file: move it away and run restore again" >&2; exit 1; }
      mkdir -p "$(dirname "$link")"
      ln -sfn "$file" "$link"
    fi
    [ "$link" != "$units_dir/$(basename "$file")" ] || ! grep -q '^\[Install\]' "$file" || enable="$enable $(basename "$file")"
  done
}

# The hub restarts onto the code on disk now, once no call is live. Given the commit hex was on, units the two differ on
# are linked again, and hex.service restarts in the hub's place when it runs this folder's hex. A hub that isn't running
# may be off on purpose, as on a machine that doesn't hold hex, so none starts, and this fails with 2.
restart_hub() {
  unit=$(systemctl --user show -P FragmentPath hex.service 2>/dev/null || :)
  if [ -n "${1:-}" ] && [ -n "$unit" ] && [ "$(readlink -f "$unit")" = "$hex/systemd/hex.service" ] && ! git -C "$hex" diff --quiet "$1" HEAD -- systemd services.json; then
    link_units && systemctl --user daemon-reload && systemctl --user restart --no-block hex.service
  elif running; then
    pkill -HUP -P "$(cat "$pidfile")" -f hub/serve.ts || :
  else
    echo "hex isn't running here, so nothing restarted; \`hex start\` starts it" >&2
    return 2
  fi
}

# The channels hex ships with a server of their own, for Claude Code's managed settings to allow.
channels() { for mcp in "$hex"/channels/*/.mcp.json; do basename "$(dirname "$mcp")"; done; }

# hex that can't start tells General itself, straight through Telegram, since no hub runs to send it. Once per
# machine, until a hub connects there again (state/down.<host>) and says it's back.
down() {
  echo "$1" >&2
  told="$home/state/down.$(uname -n)"
  [ ! -e "$told" ] || return 0
  (
    set +eu
    . "$hex/bin/settings"
    [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && [ -n "${HEX_MAIN_THREAD:-}" ] &&
      printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TELEGRAM_BOT_TOKEN" |
      curl -sf -m 10 -o /dev/null -K - --data-urlencode "chat_id=$HEX_MAIN_THREAD" --data-urlencode "text=$1 General hears here once it's back."
  ) && date +%s > "$told" || :
}

case "${1:-}" in
  init)
    for file in AGENTS.md SOUL.md PROACTIVE.md schedules.json; do
      [ -e "$home/$file" ] || cp "$hex/defaults/$file" "$home/$file"
    done
    [ -e "$home/.gitignore" ] || cp "$hex/defaults/gitignore" "$home/.gitignore"
    [ -e "$home/.env" ] || (umask 077 && cp "$hex/defaults/env" "$home/.env")
    mkdir -p "$home/.claude" "$home/state/telegram" "$home/state/discord" "$home/state/buzz" "$home/state/t3"
    [ -e "$home/.claude/settings.json" ] || jq --arg memory "$home/memory" '.env.MEMORY_DIR = $memory' "$hex/defaults/settings.json" > "$home/.claude/settings.json"
    # Claude Code runs a background session in bypassPermissions only with consent in the user's own settings.
    if [ "$(jq -r '.permissions.defaultMode' "$home/.claude/settings.json")" = bypassPermissions ]; then
      user="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
      if ! grep -q '[^[:space:]]' "$user" 2>/dev/null; then
        mkdir -p "$(dirname "$user")"
        echo '{ "skipDangerousModePermissionPrompt": true }' > "$user"
      elif ! jq -e '.skipDangerousModePermissionPrompt == true' "$user" >/dev/null 2>&1; then
        consent=$(jq '.skipDangerousModePermissionPrompt = true' "$user") || { echo "$user isn't valid JSON: add \"skipDangerousModePermissionPrompt\": true to it, then run init again" >&2; exit 1; }
        printf '%s\n' "$consent" > "$user"
      fi
    fi
    "$hex/bin/optmem"
    MEMORY_DIR="$home/memory" "$hex/vendor/memo" init >/dev/null
    (. "$hex/bin/settings"; export HEX_STORE="$home/state"; wake) || :
    chmod 700 "$home" "$home/state"
    # Before the HEAD check, so a folder inside another repo (a dotfiles repo at $HOME) gets its own.
    git -C "$home" init -q
    if ! git -C "$home" rev-parse -q --verify HEAD >/dev/null 2>&1; then
      git -C "$home" add -A
      # A fresh machine has no git identity, which would fail the first commit.
      identity=
      { git -C "$home" var GIT_AUTHOR_IDENT && git -C "$home" var GIT_COMMITTER_IDENT; } >/dev/null 2>&1 || identity="-c user.name=hex -c user.email=hex@localhost"
      git -C "$home" $identity commit -qm "chore: a new hex"
    fi
    echo "hex is set up in $home"
    ;;
  run)
    # iikb's door takes the keyboard's requests through the hub's restarts (channels/iikb/door.ts), so it runs for as long
    # as hex runs here, and goes however this ends.
    trap 'pkill -P $$ -f channels/iikb/door.ts || :' EXIT
    # A stop (TERM) or a restart (HUP) ends the hub once no call is live, and waits for it to exit. A hub still starting
    # dies of the signal before it takes it, with nothing yet to finish, and hex stops all the same. Taken before anything
    # else, since a restart in place starts here again as the hex state/hub.pid names, which a stop may come to at any
    # point; the pidfile goes only when it names this hex, not one a second hex here found running.
    leave() { [ -z "${hub:-}" ] || { kill -"$1" "$hub" 2>/dev/null; wait "$hub" || :; }; [ "$(cat "$pidfile" 2>/dev/null)" != $$ ] || rm -f "$pidfile"; exit 0; }
    trap 'leave TERM' INT TERM
    trap 'leave HUP' HUP
    # Only whatever moved hex away brings it back: it starts hex ahead of its turn.
    if [ -e "$marker" ] && [ "$(cat "$marker" 2>/dev/null)" != "$(uname -n)" ] && [ -z "${HEX_AHEAD:-}" ]; then echo "hex runs on another machine now ($marker), so it starts here only once it's moved back" >&2; exit 1; fi
    # A restart in place comes here holding the locks below (6, 7) from before it, which anything started before they're
    # taken again, like the login shell, would keep.
    exec 6>&- 7>&-
    shell_path
    # In a shell of its own, so a line of .env that fails stops the check the way it would stop the hub. Only where it
    # failed is told, since the shell's error quotes the line, which may be a secret.
    home="$home" sh -eu -c '. "$1"; [ -n "${TELEGRAM_BOT_TOKEN:-}" ]' sh "$hex/bin/settings" || {
      line=$([ ! -f "$home/.env" ] || sh -eu -c 'set -a; . "$1"' sh "$home/.env" 2>&1 >/dev/null | sed -n 's/^[^:]*: \(line \)*\([0-9][0-9]*\):.*/\2/p' | head -n 1)
      if [ -n "$line" ]; then why="line $line of $home/.env fails as a command"; else why="$home/.env sets no TELEGRAM_BOT_TOKEN"; fi
      down "hex can't start on $(uname -n): $why."
      exit 1
    }
    lease=$(. "$hex/bin/settings"; printf %s "${HEX_STORE_LEASE:-}")
    case $lease in *[!0-9]*) down "hex can't start on $(uname -n): HEX_STORE_LEASE is $lease, not a whole number."; exit 1 ;; esac
    # A hub that lost hex to another machine leaves hex stopped here, whatever starts it again, until `hex start`, or a
    # start on a newer lease than the one it was lost under, which is the lease tool giving this machine hex again.
    # state/lost holds that lease on its first line, then why.
    lost="$home/state/lost"
    if [ -e "$lost" ]; then
      under=$(head -n 1 "$lost")
      if [ -n "$lease" ] && { [ -z "$under" ] || [ "$lease" -gt "$under" ]; }; then
        rm -f "$lost"
      else
        tail -n +2 "$lost" >&2
        # What this machine's hubs owed goes to the store all the same, since no hub starts here to pay it.
        for owed in "$home"/state/owed.*.json; do
          [ ! -e "$owed" ] || (. "$hex/bin/settings"; bun "$hex/hub/paid.ts" "$home/state") || :
          break
        done
        exit 3
      fi
    fi
    export HEX_DIR="$home" HEX_LAUNCHER="$hex/bin/session" HEX_NAME="${HEX_NAME:-hex}"
    # The hex whose plugin and launcher sessions start from: a change to what they read only at start renews them at their next rest.
    export HEX_STARTUP="$hex"
    export TELEGRAM_STATE_DIR="$home/state/telegram" DISCORD_STATE_DIR="$home/state/discord" BUZZ_STATE_DIR="$home/state/buzz" T3_STATE_DIR="$home/state/t3"
    # A restart finds the door by HEX_DOOR, its file and port as it started, and replaces it only when one of them has
    # changed, as after an update or a rollback, or when it's gone.
    doors() { pgrep -P $$ -f channels/iikb/door.ts >/dev/null; }
    door() {
      now=$(. "$hex/bin/settings"; file=$(cksum "$hex/channels/iikb/door.ts" 2>/dev/null) && echo "$file ${IIKB_PORT:-}") || now=
      [ "$now" != "${HEX_DOOR:-}" ] || ! doors || return 0
      pkill -P $$ -f channels/iikb/door.ts || :
      while doors; do sleep 0.1; done
      export HEX_DOOR="$now"
      if [ -n "$now" ]; then (. "$hex/bin/settings"; exec bun "$hex/channels/iikb/door.ts" "$home/state") 6>&- 7>&- & fi
    }
    start() {
      door
      bun install --no-summary --cwd "$hex" >/dev/null || :
      # Read at every start, so a restart takes the settings as they are now.
      (. "$hex/bin/settings"; exec bun "$hex/hub/serve.ts") 6>&- 7>&- &
      hub=$!
    }
    # One hex runs a folder on a machine, however it was started: a second leaves the first be.
    command -v flock >/dev/null || { down "hex can't start on $(uname -n): flock isn't installed (INSTALL.md step 1)."; exit 1; }
    exec 6>"$home/state/run.lock"
    flock -n 6 || { echo "hex runs here already" >&2; exit 0; }
    # A move holds state/records.lock alone, and hex here holds it beside nothing but itself for as long as it runs,
    # however it was started, so no hub starts on records that are moving. What hex starts holds neither (6>&- 7>&-).
    exec 7>"$home/state/records.lock"
    flock -n -s 7 || { echo "hex waits for its records to finish moving before its hub starts" >&2; flock -s 7 6>&- & wait $!; }
    # Started ahead of its turn, while hex still runs on another machine that's handing it over, the hub gets ready and
    # waits (hub/ahead.ts), and so does the rest of hex here, until the file HEX_AHEAD names is gone.
    start
    [ -z "${HEX_AHEAD:-}" ] || bun "$hex/hub/ahead.ts" "$HEX_AHEAD" 6>&- 7>&-
    echo $$ > "$pidfile"
    # Apps following hex with `hex watch` read it again as it starts, as after a restore of hex.db.
    printf . >> "$home/state/hex.bell"
    first= second= third=
    while :; do
      [ -n "$hub" ] || start
      # Jobs a move or their machine going down stopped carry on, alongside each start of the hub, so a pass that failed
      # is tried again; one whose unit runs is left alone.
      (. "$hex/bin/settings"; bun "$hex/bin/job" --resume || echo "hex: jobs that were stopped didn't resume; the hub's next start tries again" >&2) 6>&- 7>&- &
      exited=0
      wait "$hub" || exited=$?
      hub=
      if [ "$exited" = 0 ]; then
        # A restart: go on as the bin/hex on disk now, which an update may have changed.
        sh -n "$hex/bin/hex" && exec "$hex/bin/hex" run
        continue
      fi
      # The store refused the hub for an older tenure: another machine holds hex, so a hub here would fight it. hex stays
      # stopped here, with the same code, which hex.service doesn't restart.
      if [ "$exited" = 3 ]; then
        { echo "$lease"; echo "hex stopped on $(uname -n): its store gave hex to another hub, so it stays stopped here, whatever starts it, until \`hex start\` (the hub's log says why). Start it here again only if no other machine runs hex; if hex no longer runs under a lease, run \`hex store lease clear\` first."; } > "$lost"
        down "$(tail -n +2 "$lost")"
        rm -f "$pidfile"
        exit 3
      fi
      first=$second second=$third third=$(date +%s)
      if [ -n "$first" ] && [ $((third - first)) -le 60 ]; then
        # A store that doesn't answer stops a hub whatever its commit, so hex stays on the commit and tries again.
        if [ -e "$store" ] && ! answers < "$store" >/dev/null; then
          down "hex on $(uname -n) can't reach its records at $(jq -r .url "$store"): its hub keeps starting again, on the same commit, until they answer."
        else
          # With nothing to go back to, hex stops as failed, for its service manager to see and act on.
          roll_back || { down "hex can't start on $(uname -n): its hub exited three times within a minute, and there's no earlier hex to go back to. What it printed is in the hub's log (state/hub.log, or the journal of the unit that runs hex)."; rm -f "$pidfile"; exit 1; }
        fi
        first= second= third=
      fi
      sleep 3
    done
    ;;
  start)
    rm -f "$home/state/lost"
    running && exit 0
    if own_unit; then systemctl --user start --no-block hex.service; echo "hex started, as hex.service"; exit 0; fi
    nohup "$0" run >> "$home/state/hub.log" 2>&1 &
    echo "hex started; its log is state/hub.log"
    ;;
  stop)
    ! own_unit || systemctl --user stop hex.service
    running || exit 0
    pid=$(cat "$pidfile")
    kill "$pid"
    # The hub finishes a live call first; whatever starts hex next waits for it to be gone.
    while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done
    ;;
  restart)
    restart_hub "${2:-}" || [ $? = 2 ]
    ;;
  rollback)
    # The way back for a commit that starts but misbehaves, in seconds: no check and no store deploy, since an older hex
    # runs on a newer store, as every update already has it do for the minutes before it restarts.
    where_hex_runs "$@"
    [ -n "${2:-}" ] || { echo "usage: hex rollback <commit>, an earlier commit of hex to go back to" >&2; exit 2; }
    to=$(git -C "$hex" rev-parse -q --verify "$2^{commit}") || { echo "hex rollback: hex has no commit $2 here" >&2; exit 1; }
    left=$(git -C "$hex" rev-parse HEAD)
    if [ "$to" != "$left" ]; then
      git -C "$hex" merge-base --is-ancestor "$to" HEAD || { echo "hex rollback: hex goes back only to a commit it's built on, and $(described "$to") isn't one" >&2; exit 1; }
      limit=
      ! command -v timeout >/dev/null || limit="timeout 10"
      $limit git -C "$hex" fetch -q origin main 2>/dev/null || echo "hex rollback: GitHub didn't answer, so what main built on the commit hex leaves is refused as of this machine's last fetch" >&2
      # Under the lock bin/update merges under, so an update that asked before can't merge after. The refusal is
      # written before hex moves, so hex never goes back with nothing refused, and taken out if hex can't move.
      exec 9>"$home/state/checkout.lock"
      flock 9
      left=$(git -C "$hex" rev-parse HEAD)
      newest=$left
      ! git -C "$hex" merge-base --is-ancestor "$left" origin/main 2>/dev/null || newest=$(git -C "$hex" rev-parse origin/main)
      printf '%s %s\n' "$newest" "$to" >> "$home/state/refused" || { echo "hex rollback: hex couldn't write what it refuses to state/refused, so it stays on $(described "$left")" >&2; exit 1; }
      git -C "$hex" reset -q --keep "$to" 9>&- || { sed '$d' "$home/state/refused" > "$home/state/refused.new" && mv "$home/state/refused.new" "$home/state/refused"; exit 1; }
      exec 9>&-
      # As roll_back writes it, for an older hex's bin/update, so going back across this one holds too.
      echo "$newest" > "$home/state/bad" || :
      rm -f "$home/state/good"
      echo "hex went back from $(described "$left") to $(described "$to") by \`hex rollback\`. bin/update won't take it, or what main had built on it, until main moves past them, on whichever machine runs hex." > "$home/state/rollback" || :
    elif [ "$(cat "$home/state/good" 2>/dev/null)" = "$to" ] && running; then
      echo "hex is on $(described "$to") already, and its hub runs it"
      exit 0
    fi
    # From here on, run again, it finishes a rollback that stopped half way: HEAD@{1} is the commit hex left.
    was=$(! running || pgrep -P "$(cat "$pidfile")" -f hub/serve.ts || :)
    restart_hub "$(git -C "$hex" rev-parse -q --verify 'HEAD@{1}')" || { echo "hex rollback: hex's code is on $(described "$to"), but no hub restarted on it (above). \`hex rollback $(git -C "$hex" rev-parse --short "$to")\` again finishes the rollback." >&2; exit 1; }
    # A hub starts in seconds, and General connects to it in a few more; past two minutes, what's in the way is said.
    waited=0
    until [ "$(cat "$home/state/good" 2>/dev/null)" = "$to" ] && running; do
      if [ "$waited" -ge "${HEX_ROLLBACK_WAIT:-120}" ]; then
        if [ -n "$was" ] && kill -0 "$was" 2>/dev/null; then
          why="the hub from before (pid $was) hasn't stopped: it waits for a live call to end, or its stop hangs, and \`kill $was\` ends it"
        else
          why="what its hub printed is in the hub's log (state/hub.log, or the journal of the unit that runs hex), and \`hex rollback <an earlier commit>\` goes further back"
        fi
        echo "hex rollback: hex's code is on $(described "$to"), but after ${waited}s no hub is up on it: $why. \`hex rollback $(git -C "$hex" rev-parse --short "$to")\` again finishes the rollback." >&2
        exit 1
      fi
      sleep 1
      waited=$((waited + 1))
    done
    echo "hex is back on $(described "$to"): a hub runs it, and General connected to it."
    ;;
  refused)
    [ -n "${2:-}" ] || { echo "usage: hex refused <commit>" >&2; exit 2; }
    refused "$2" || { echo "not refused: $2"; exit 1; }
    ;;
  acp)
    exec bun "$hex/channels/t3/acp.ts" "$home/state/t3/acp.sock"
    ;;
  store)
    if [ "${2:-}" = deploy ]; then
      # Deploys the store of a hex folder (this one, or the one an update checked) with this folder's settings, where
      # .env keeps CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID for wrangler, and HEX_STORE_KEY.
      . "$hex/bin/settings"
      from=$(cd "${3:-$hex}" && pwd)
      config="$from/hub/store/wrangler.jsonc"
      built=$(mktemp -d)
      trap 'rm -rf "$built"' EXIT
      # The store's version is what its Worker is built from, so a change anywhere in its bundle deploys it and nothing
      # else does, then the commit it was built at and when, so no deploy puts older code over newer.
      $wrangler deploy --dry-run --outdir "$built" --config "$config" >/dev/null
      version="$(cat "$built"/*.js "$config" | git hash-object --stdin)@$(git -C "$from" log -1 --format=%H@%ct)"
      # Proven where hex points, or before a move at the Worker's own address.
      target() { if [ -e "$store" ]; then cat "$store"; else printf '{"url":"%s","name":"hex","key":"%s"}' "$url" "$key"; fi; }
      # A running object takes new code only when it starts again, which Cloudflare defers up to five minutes unless
      # told otherwise: hex's object restarts on it at once, and its callers ride out the restart as an outage.
      now_mode="--durable-objects-code-update-mode immediate"
      # Waits for the store to answer as the version given, past the longest Cloudflare would defer it.
      # heard keeps what it last answered.
      heard=
      as() {
        tries=0 heard=
        until now=$(target | answers) && heard=$now && [ "$now" = "$1" ]; do
          [ $((tries += 1)) -lt 165 ] || return 1
          sleep 2
        done
      }
      secret=
      if [ -e "$store" ]; then
        was=$(answers < "$store") || { echo "the store at $(jq -r .url "$store") doesn't answer, so nothing deploys over it: whether this one is newer can't be told" >&2; exit 1; }
        [ "${was%%@*}" != "${version%%@*}" ] || { echo "the store hex points at runs this code already ($was)"; exit 0; }
        # Which commit is newer goes by when each was made, since a squash merge leaves the one a store was deployed
        # from out of main's history.
        made=${was##*@}
        case $made in '' | *[!0-9]*) ;; *) [ "$made" -le "${version##*@}" ] || { echo "the store hex points at was built from a commit made after this one (${was#*@}), so it stays: deploy from a hex at least as new" >&2; exit 1; } ;; esac
        key=$(jq -r .key "$store")
      else
        # The key goes up only to a Worker that answers to none yet, so no machine that has no key locks out the ones
        # that use it.
        worker=$(sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p' "$config" | head -n 1)
        keys=$($wrangler secret list --config "$config" --format json 2>&1) || case $keys in
          *"Worker \"$worker\" not found."*"If this is a new Worker, run"*) keys= ;;
          *) printf '%s\n' "$keys" >&2; exit 1 ;;
        esac
        if printf %s "$keys" | tr -d ' \n' | grep -q '"name":"KEY"'; then
          key=${HEX_STORE_KEY:-}
          [ -n "$key" ] || { echo "the Worker answers to a key already: put HEX_STORE_KEY from the .env of the machine that made it in this one's, or copy its state/store.json" >&2; exit 1; }
        else
          secret=1
          key=${HEX_STORE_KEY:-}
          [ -n "$key" ] || { key=$(head -c 33 /dev/urandom | base64); printf '\nHEX_STORE_KEY=%s\n' "$key" >> "$home/.env"; }
        fi
      fi
      # A new key goes up with the code, as one version, through stdin: never in a shell's history or ps.
      out=$(if [ -n "$secret" ]; then printf '{"KEY":"%s"}' "$key" | $wrangler deploy --config "$config" $now_mode --var "VERSION:$version" --secrets-file /dev/stdin; else $wrangler deploy --config "$config" $now_mode --var "VERSION:$version"; fi 2>&1) || { printf '%s\n' "$out" >&2; exit 1; }
      url=$(printf '%s\n' "$out" | grep -o 'https://[^ ]*\.workers\.dev' | head -n 1) || :
      to=$(target | jq -r .url)
      as "$version" || {
        # A store that still answers, as the code before, runs on the records as the new one would, since migrations
        # only add and an older hex runs on a newer store: Cloudflare is still taking the new one out, so it stays, and
        # the next update finds it there (exit 2). One that answers not at all can't run, so the code before goes back.
        if [ -n "$heard" ]; then
          echo "the store at $to still answers as $heard, not as $version, the one deployed, after five and a half minutes: Cloudflare is still taking it out, so it stays deployed" >&2
          exit 2
        fi
        if ! $wrangler rollback --config "$config" $now_mode -y -m "hex: $to didn't answer as $version" >/dev/null 2>&1; then back="there was no store before it to put back"
        elif [ -z "${was:-}" ] || as "$was"; then back="the store before it is back"
        else back="the store before it is back, and doesn't answer either"; fi
        echo "the store at ${to:-the Worker's address} didn't answer at all in five and a half minutes as $version, the one deployed: $back" >&2
        exit 1
      }
      # Before a move, the Worker's address is kept for `hex status`, which has no store.json to find it by yet.
      [ -e "$store" ] || echo "$to" > "$home/state/store.deployed"
      echo "the store at $to answers as $version"
      exit 0
    fi
    if [ "${2:-}" = move ] || [ "${2:-}" = back ]; then
      # A hub that writes while its records move would leave rows where nothing reads them: a move either way holds
      # state/records.lock alone, which hex here holds for as long as it runs, so neither starts while the other runs.
      exec 7>"$home/state/records.lock"
      flock -n -x 7 || { echo "hex is running here: stop it first, so nothing writes its records while they move" >&2; exit 1; }
      moved=0
      where=$(elsewhere) || moved=$?
      [ "$moved" != 2 ] || { echo "hex is moving between machines: move its records once it's done, from where it runs" >&2; exit 1; }
      [ "$moved" != 0 ] || { echo "hex runs on $where, whose records are the newest: stop it there and move them from there" >&2; exit 1; }
      # The key `hex store deploy` made is in .env, as HEX_STORE_KEY, and a lease tool's number may be in the settings.
      . "$hex/bin/settings"
      if [ "$2" = move ]; then
        bun "$hex/hub/store/move.ts" "$home/state" "${3:-}" "${4:-}" && exit 0 || failed=$?
        # store.json is written once every row compared equal: from then on hex is on the object, whatever the move
        # left untidied in hex.db after it.
        [ -e "$store" ] || exit "$failed"
        echo "hex's records are in the object, which state/store.json points hex at, though the move ended before it set hex.db aside" >&2
        exit 0
      fi
      # Back from the object to state/hex.db; where it's there already, nothing to do, so this can run as a start step.
      [ -e "$store" ] || { echo "hex's records are in state/hex.db already"; exit 0; }
      exec bun "$hex/hub/store/back.ts" "$home/state"
    fi
    exec bun "$hex/hub/cli.ts" "$home/state" "$@"
    ;;
  elsewhere)
    elsewhere
    ;;
  status)
    if running; then echo "hub: running (pid $(cat "$pidfile"))"; else echo "hub: stopped"; fi
    [ ! -e "$home/state/lost" ] || echo "hub: stays stopped, since another machine took hex (\`hex start\` starts it)"
    if [ -e "$store" ]; then
      if version=$(answers < "$store"); then echo "store: $(jq -r .url "$store") answers, as $version"; else echo "store: $(jq -r .url "$store") doesn't answer, so the hub waits for it"; fi
    elif [ -e "$home/state/store.deployed" ]; then
      deployed=$(cat "$home/state/store.deployed")
      key=$(. "$hex/bin/settings"; printf %s "${HEX_STORE_KEY:-}")
      if version=$(printf '{"url":"%s","name":"hex","key":"%s"}' "$deployed" "$key" | answers); then
        echo "store: hex.db here; the Worker at $deployed answers, as $version, ready for a move"
      else
        echo "store: hex.db here; the Worker at $deployed doesn't answer"
      fi
    fi
    bun "$hex/hub/cli.ts" "$home/state" running || echo "sessions: hex running failed"
    units=$(systemctl --user list-units --type=service --state=running --no-legend --plain 2>/dev/null | awk '{print $1}')
    if [ -n "$units" ]; then
      systemctl --user show $units -p Id,ActiveEnterTimestamp,ExecStopPost 2>/dev/null | awk -F= -v job=" $(cd "$hex" && pwd -P)/bin/job --ended " '
        function done() { if (ours) print "job " substr(id, 1, length(id) - 8) ": running since " since; ours = 0 }
        /^$/ { done() } /^Id=/ { id = $2 } /^ActiveEnterTimestamp=/ { since = $2 } /^ExecStopPost=/ && index($0, job) { ours = 1 }
        END { done() }'
    fi
    ;;
  link)
    ! systemd || { link_units; systemctl --user daemon-reload; }
    ;;
  restore)
    PATH=$HOME/.local/bin:$HOME/.bun/bin:$PATH
    missing=
    for tool in git curl jq python3 flock; do command -v "$tool" >/dev/null || missing="$missing $tool"; done
    [ -z "$missing" ] || { echo "restore: install$missing with the system's package manager first (INSTALL.md step 1)" >&2; exit 1; }
    # Each thing a list installs is made by its line when it's missing. A line that fails is said and fails restore at
    # its end, once the rest is set up, so one broken install leaves no unit off.
    failed=
    for list in $(lists); do
      cd "$(dirname "$list")"
      eval "set -- $(jq -r '.install // {} | to_entries | map(.key, .value) | @sh' "$list")"
      while [ $# -gt 0 ]; do
        need=$1 how=$2
        shift 2
        there "$need" && continue
        echo "installing $need"
        sh -c "$how" </dev/null && there "$need" || { echo "restore: \`$how\` didn't make $need" >&2; failed=1; }
      done
    done
    cd "$home"
    bun install --no-summary --cwd "$hex" >/dev/null
    "$hex/bin/hex" init >/dev/null
    # hex turns each channel on in its own sessions only, so it's installed turned off.
    marketplace=$(claude plugin marketplace list --json | jq -r '.[] | select(.name == "hex") | .path // "elsewhere"')
    if ! [ "$marketplace" -ef "$hex/channels" ]; then
      # One brought over from another machine points at its hex.
      [ -z "$marketplace" ] || claude plugin marketplace remove hex >/dev/null
      claude plugin marketplace add "$hex/channels" >/dev/null
    fi
    installed=$(claude plugin list --json)
    for channel in $(channels); do
      printf '%s\n' "$installed" | jq -e --arg id "$channel@hex" 'any(.[]; .id == $id)' >/dev/null && continue
      claude plugin install "$channel@hex" >/dev/null && claude plugin disable "$channel@hex" >/dev/null || { echo "restore: the $channel channel didn't install" >&2; exit 1; }
      echo "installed the $channel channel"
    done
    # Claude Code's managed settings: what's there, with the lists' own, and every channel of hex allowed.
    current=$(cat "$managed" 2>/dev/null) || current='{}'
    allowed=$(channels | jq -R '{ plugin: ., marketplace: "hex" }' | jq -s .)
    wanted=$(lists | xargs jq -s --argjson current "$current" --argjson allowed "$allowed" '
      . as $lists
      | reduce $lists[] as $list ($current; . * ($list.managed // {}))
      | .channelsEnabled = true
      | .allowedChannelPlugins = (([$current, $lists[].managed] | map(.allowedChannelPlugins // []) | add) + $allowed | unique)')
    if [ "$(printf '%s' "$wanted" | jq -S .)" != "$(printf '%s' "$current" | jq -S '.allowedChannelPlugins |= (. // [] | unique)')" ]; then
      printf '%s\n' "$wanted" | sudo sh -c 'mkdir -p "$(dirname "$1")" && cat > "$1"' sh "$managed"
      echo "wrote $managed"
    fi
    "$hex/bin/trust" "$home"
    # Setting a machine up to run hex is starting it here, as `hex start` is.
    rm -f "$home/state/lost"
    if systemd; then
      link_units
      # hex.service runs ~/hex; a folder elsewhere gets a drop-in that runs it instead.
      if [ "$hex" != "$HOME/hex/.hex" ]; then
        mkdir -p "$units_dir/hex.service.d"
        printf '[Service]\nExecStart=\nExecStart="%s/bin/hex" run\n' "$hex" > "$units_dir/hex.service.d/folder.conf"
      else
        rm -f "$units_dir/hex.service.d/folder.conf"
      fi
      systemctl --user daemon-reload
      starting() { systemctl --user is-active hex.service | grep -Eqx 'active|activating'; }
      # A hub started by hand gives way to its unit.
      starting || "$hex/bin/hex" stop
      # A unit that won't start is doctor's to report, and hex.service is active only once its hub serves.
      systemctl --user enable --now --no-block $enable || :
      # Services keep running once the user logs out, and start as the machine boots.
      user=$(id -un)
      [ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null)" = yes ] || loginctl enable-linger "$user" 2>/dev/null || sudo loginctl enable-linger "$user" || :
      # systemd-oomd stops the unit that stalls the machine on memory, before the machine stops answering.
      ! oomd_off || sudo systemctl enable --now systemd-oomd.service || :
    else
      set --
      [ ! -f "$home/services.json" ] || eval "set -- $(units "$home/services.json")"
      names=$(for file; do basename "$file"; done | paste -sd' ' -)
      echo "no systemd user manager here, so hex runs on its own${names:+, and your units don't run: $names}; have the machine start hex as it boots (INSTALL.md step 5)"
      "$hex/bin/hex" start
      starting() { :; }
    fi
    # The hub writes its pid as it starts.
    tries=0
    while ! running && [ $((tries += 1)) -le 30 ] && starting; do sleep 1; done
    "$hex/bin/hex" doctor && [ -z "$failed" ]
    ;;
  doctor)
    shell_path
    problems=0
    ok() { echo "ok   $1"; }
    fix() { echo "fix  $1"; problems=$((problems + 1)); }
    hub() { systemctl --user show -p "$1" --value hex.service; }
    # A condition kept hex.service's last start off this machine; a unit never started has no condition timestamp.
    waits() {
      ! running && systemd && { [ "$(hub Result)" = exec-condition ] \
        || { [ "$(hub ConditionResult)" = no ] && [ "$(hub ConditionTimestampMonotonic)" != 0 ]; }; }
    }
    # The hub gets hex.service's environment files, then the settings; a file it writes as it starts may not be there yet.
    files=$(! systemd || hub EnvironmentFiles | sed 's/ (ignore_errors=[a-z]*)$//')
    unwritten=$(printf '%s\n' "$files" | while IFS= read -r file; do [ -z "$file" ] || [ -f "$file" ] || echo "$file"; done)
    for tool in git curl jq python3 flock bun claude; do
      command -v "$tool" >/dev/null && ok "$tool" || fix "$tool isn't on PATH (INSTALL.md step 1)"
    done
    if command -v claude >/dev/null && command -v jq >/dev/null; then
      days=$(claude auth status 2>/dev/null | jq -r 'select(.loggedIn) | (.loginExpiresAt // empty | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 - now) / 86400 | floor') || days=
      if ! claude auth status 2>/dev/null | jq -e .loggedIn >/dev/null; then
        fix "Claude Code isn't signed in: run \`claude auth login\`"
      elif [ -n "$days" ] && [ "$days" -lt 3 ]; then
        fix "Claude sign-in ends in $days days: run \`claude auth login\` before then"
      else
        ok "Claude signed in${days:+, for $days more days}"
      fi
      [ "$(jq -r --arg home "$home" '.projects[$home].hasTrustDialogAccepted' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" 2>/dev/null)" = true ] \
        && ok "$home is trusted" || fix "$home isn't trusted: run \`$hex/bin/hex restore\`"
      plugins=$(claude plugin list --json 2>/dev/null) || plugins='[]'
    fi
    token=$(printf '%s\n' "$files" | {
      while IFS= read -r file; do [ ! -f "$file" ] || { set -a; . "$file"; set +a; }; done
      . "$hex/bin/settings"
      printf %s "${TELEGRAM_BOT_TOKEN:-}"
    })
    if [ -z "$token" ] && [ -n "$unwritten" ] && waits; then
      ok "Telegram bot token: checked once hex.service writes $(echo $unwritten) as it starts"
    else
      [ -n "$token" ] && curl -sf -m 10 "https://api.telegram.org/bot$token/getMe" >/dev/null \
        && ok "Telegram bot token works" || fix "TELEGRAM_BOT_TOKEN in $home/.env is missing or Telegram rejects it (INSTALL.md steps 3-4)"
    fi
    (. "$hex/bin/settings"; [ -n "${HEX_MAIN_THREAD:-}" ]) && ok "HEX_MAIN_THREAD is set" || fix "HEX_MAIN_THREAD isn't set in $home/.env (INSTALL.md step 4)"
    jq -e '.allowFrom | length > 0' "$home/state/telegram/access.json" >/dev/null 2>&1 \
      && ok "Telegram access list" || fix "nobody may talk to hex: write $home/state/telegram/access.json (INSTALL.md step 4)"
    for channel in $(channels); do
      printf '%s\n' "${plugins:-[]}" | jq -e --arg id "$channel@hex" 'any(.[]; .id == $id)' >/dev/null || continue
      jq -e --arg plugin "$channel" '.channelsEnabled == true and any(.allowedChannelPlugins[]?; .plugin == $plugin and .marketplace == "hex")' "$managed" >/dev/null 2>&1 \
        && ok "$channel channel installed and allowed" || fix "$managed doesn't allow the $channel@hex channel: run \`$hex/bin/hex restore\`"
    done
    printf '%s\n' "${plugins:-[]}" | jq -e 'any(.[]; .id == "telegram@hex")' >/dev/null || fix "the Telegram channel isn't installed: run \`$hex/bin/hex restore\`"
    [ -d "$home/memory" ] && ok "memory in $home/memory" || fix "no memory folder: run \`$hex/bin/hex init\`"
    if systemd; then
      before=$problems
      eval "set -- $(units)"
      for file; do
        link=$(link_of "$file") name=$(basename "$file")
        if ! linked "$link" "$file"; then
          fix "$name isn't linked from $file: run \`$hex/bin/hex restore\`"
        elif [ "$link" = "$units_dir/$name" ] && { systemctl --user -q is-failed "$name" || [ "$(systemctl --user show -p SubState --value "$name")" = auto-restart ]; }; then
          fix "$name failed: see \`journalctl --user -u $name\`"
        fi
      done
      [ "$problems" -gt "$before" ] || ok "$# unit files linked, none failed"
      [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" = yes ] && ok "services run while you're logged out" \
        || fix "services stop when you log out: run \`sudo loginctl enable-linger $(id -un)\`"
      systemctl is-active -q systemd-oomd.service && ok "systemd-oomd stops what stalls the machine on memory" \
        || fix "nothing stops a job that runs the machine out of memory: install systemd-oomd and run \`sudo systemctl enable --now systemd-oomd\`"
    fi
    if [ -e "$store" ]; then
      version=$(answers < "$store") && ok "hex's records at $(jq -r .url "$store") answer, as $version" \
        || fix "hex's records at $(jq -r .url "$store") don't answer, so the hub waits for them: check the address, the key and the Worker (INSTALL.md, On more than one machine)"
    fi
    if running; then
      ok "hub running (pid $(cat "$pidfile"))"
    elif waits; then
      ok "hub waits: a condition of hex.service keeps it off this machine"
    else
      fix "the hub isn't running: run \`$hex/bin/hex restore\`"
    fi
    free=$(df -Pk "$home" | awk 'NR == 2 { print int($4 / 1048576) }')
    [ "${free:-0}" -ge 5 ] && ok "$free GB free on disk" || fix "only ${free:-0} GB free on disk: sessions and backups need room"
    [ "$problems" -eq 0 ] && echo "hex looks healthy" || { echo "$problems to fix"; exit 1; }
    ;;
  *)
    # Every other command is a file in hub/cli/, named in lowercase letters; anything else gets the usage, at once.
    case ${1:-} in '' | *[!a-z]*) command= ;; *) command=$1 ;; esac
    if [ -z "$command" ] || [ ! -f "$hex/hub/cli/$command.ts" ]; then
      echo "usage: hex init|link|restore|start|stop|restart|status|doctor|run|acp|elsewhere|rollback <commit>|refused <commit>|store deploy|store move|store back" >&2
      exec bun "$hex/hub/cli.ts" "$home/state"
    fi
    export MEMORY_DIR="${MEMORY_DIR:-$home/memory}"
    where_hex_runs "$@"
    exec bun "$hex/hub/cli.ts" "$home/state" "$@"
    ;;
esac
