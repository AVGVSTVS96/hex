#!/bin/sh
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
pidfile="$home/state/hub.pid"

running() {
  [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

# A service manager starts hex with a bare PATH, so hex takes the one the user's own shell builds,
# rc files included, and sessions and jobs find what a terminal finds. A shell that hangs or fails leaves PATH as it is.
shell_path() {
  limit=
  ! command -v timeout >/dev/null || limit="timeout 10"
  found=$($limit "${SHELL:-/bin/sh}" -ilc 'echo; echo hex-path; env' </dev/null 2>/dev/null | sed -n '/^hex-path$/,$s/^PATH=//p' | tail -n 1) || :
  [ -z "$found" ] || PATH=$(printf '%s:%s' "$found" "$PATH" | tr : '\n' | awk 'NF && !seen[$0]++' | paste -sd: -)
}

# A hub that exits three times within a minute can't start. If hex changed since General last
# connected (the hub writes that commit to state/good), hex goes back to it, bin/update won't take
# the commit that failed (state/bad) again, and General hears why once it's back.
roll_back() {
  good=$(cat "$home/state/good" 2>/dev/null) || return 0
  bad=$(git -C "$hex" rev-parse HEAD)
  [ -n "$good" ] && [ "$good" != "$bad" ] && git -C "$hex" reset -q --keep "$good" || return 0
  echo "$bad" > "$home/state/bad"
  note="hex $(git -C "$hex" log -1 --format='%h ("%s")' "$bad") couldn't start: its hub exited three times within a minute. So hex went back to $(git -C "$hex" log -1 --format='%h ("%s")' "$good"), the last commit General connected on, and bin/update won't take $(git -C "$hex" rev-parse --short "$bad") again. What the failed starts printed is in the hub's log (state/hub.log, or the journal of the unit that runs hex)."
  echo "$note" >&2
  echo "$note" > "$home/state/rollback"
}

case "${1:-}" in
  init)
    for file in AGENTS.md SOUL.md schedules.json; do
      [ -e "$home/$file" ] || cp "$hex/defaults/$file" "$home/$file"
    done
    [ -e "$home/.gitignore" ] || cp "$hex/defaults/gitignore" "$home/.gitignore"
    [ -e "$home/.env" ] || (umask 077 && cp "$hex/defaults/env" "$home/.env")
    mkdir -p "$home/.claude" "$home/state/telegram" "$home/state/discord" "$home/state/buzz" "$home/state/t3"
    [ -e "$home/.claude/settings.json" ] || jq --arg memory "$home/memory" '.env.MEMORY_DIR = $memory' "$hex/defaults/settings.json" > "$home/.claude/settings.json"
    # Claude Code runs a background session in bypassPermissions only with consent in the user's own settings.
    if [ "$(jq -r '.permissions.defaultMode' "$home/.claude/settings.json")" = bypassPermissions ]; then
      user="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
      if ! grep -q '[^[:space:]]' "$user" 2>/dev/null; then
        mkdir -p "$(dirname "$user")"
        echo '{ "skipDangerousModePermissionPrompt": true }' > "$user"
      elif ! jq -e '.skipDangerousModePermissionPrompt == true' "$user" >/dev/null 2>&1; then
        consent=$(jq '.skipDangerousModePermissionPrompt = true' "$user") || { echo "$user isn't valid JSON: add \"skipDangerousModePermissionPrompt\": true to it, then run init again" >&2; exit 1; }
        printf '%s\n' "$consent" > "$user"
      fi
    fi
    "$hex/bin/optmem"
    MEMORY_DIR="$home/memory" "$hex/vendor/memo" init >/dev/null
    (. "$hex/bin/settings"; export HEX_STORE="$home/state"; wake) || :
    chmod 700 "$home" "$home/state"
    [ -d "$home/.git" ] || { git -C "$home" init -q && git -C "$home" add -A && git -C "$home" commit -qm "chore: a new hex"; }
    echo "hex is set up in $home"
    ;;
  run)
    shell_path
    (. "$hex/bin/settings"; [ -n "${TELEGRAM_BOT_TOKEN:-}" ]) || { echo "no TELEGRAM_BOT_TOKEN in $home/.env" >&2; exit 1; }
    export HEX_DIR="$home" HEX_LAUNCHER="$hex/bin/session" HEX_NAME="${HEX_NAME:-hex}"
    # The hex whose plugin and launcher sessions start from: a change to what they read only at start renews them at their next rest.
    export HEX_STARTUP="$hex"
    export TELEGRAM_STATE_DIR="$home/state/telegram" DISCORD_STATE_DIR="$home/state/discord" BUZZ_STATE_DIR="$home/state/buzz" T3_STATE_DIR="$home/state/t3"
    echo $$ > "$pidfile"
    # Apps following hex with `hex watch` read it again as it starts, as after a restore of hex.db.
    printf . >> "$home/state/hex.bell"
    # A stop ends the hub the way a restart does, once no call is live, and waits for it to exit.
    trap '[ -z "${hub:-}" ] || { kill -TERM "$hub" 2>/dev/null; wait "$hub"; }; rm -f "$pidfile"; exit 0' INT TERM
    # Jobs the machine going down stopped carry on.
    (. "$hex/bin/settings"; bun "$hex/bin/job" --resume) || :
    first= second= third=
    while :; do
      bun install --no-summary --cwd "$hex" >/dev/null || :
      # Read at every start, so a restart takes the settings as they are now.
      (. "$hex/bin/settings"; exec bun "$hex/hub/serve.ts") &
      hub=$!
      if wait "$hub"; then
        hub=
        # A restart: go on as the bin/hex on disk now, which an update may have changed.
        sh -n "$hex/bin/hex" && exec "$hex/bin/hex" run
        continue
      fi
      hub=
      first=$second second=$third third=$(date +%s)
      if [ -n "$first" ] && [ $((third - first)) -le 60 ]; then
        roll_back
        first= second= third=
      fi
      sleep 3
    done
    ;;
  start)
    running && exit 0
    nohup "$0" run >> "$home/state/hub.log" 2>&1 &
    echo "hex started; its log is state/hub.log"
    ;;
  stop)
    running || exit 0
    pid=$(cat "$pidfile")
    kill "$pid"
    # The hub finishes a live call first; whatever starts hex next waits for it to be gone.
    while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done
    ;;
  restart)
    running && pkill -HUP -P "$(cat "$pidfile")" -f hub/serve.ts || "$0" start
    ;;
  acp)
    exec bun "$hex/channels/t3/acp.ts" "$home/state/t3/acp.sock"
    ;;
  deliver|task|tasks|hold|holds|questions|pins|threads|running|message|profile|log|recall|watch)
    export MEMORY_DIR="${MEMORY_DIR:-$home/memory}"
    exec bun "$hex/hub/cli.ts" "$home/state" "$@"
    ;;
  status)
    if running; then echo "hub: running (pid $(cat "$pidfile"))"; else echo "hub: stopped"; fi
    bun "$hex/hub/cli.ts" "$home/state" running || echo "sessions: hex running failed"
    units=$(systemctl --user list-units --type=service --state=running --no-legend --plain 2>/dev/null | awk '{print $1}')
    if [ -n "$units" ]; then
      systemctl --user show $units -p Id,ActiveEnterTimestamp,ExecStopPost 2>/dev/null | awk -F= -v job=" $(cd "$hex" && pwd -P)/bin/job --ended " '
        function done() { if (ours) print "job " substr(id, 1, length(id) - 8) ": running since " since; ours = 0 }
        /^$/ { done() } /^Id=/ { id = $2 } /^ActiveEnterTimestamp=/ { since = $2 } /^ExecStopPost=/ && index($0, job) { ours = 1 }
        END { done() }'
    fi
    ;;
  doctor)
    shell_path
    problems=0
    ok() { echo "ok   $1"; }
    fix() { echo "fix  $1"; problems=$((problems + 1)); }
    for tool in git curl jq bun claude; do
      command -v "$tool" >/dev/null && ok "$tool" || fix "$tool isn't on PATH (INSTALL.md step 1)"
    done
    if command -v claude >/dev/null && command -v jq >/dev/null; then
      days=$(claude auth status 2>/dev/null | jq -r 'select(.loggedIn) | (.loginExpiresAt // empty | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 - now) / 86400 | floor') || days=
      if ! claude auth status 2>/dev/null | jq -e .loggedIn >/dev/null; then
        fix "Claude Code isn't signed in: run \`claude auth login\`"
      elif [ -n "$days" ] && [ "$days" -lt 3 ]; then
        fix "Claude sign-in ends in $days days: run \`claude auth login\` before then"
      else
        ok "Claude signed in${days:+, for $days more days}"
      fi
      [ "$(jq -r --arg home "$home" '.projects[$home].hasTrustDialogAccepted' "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" 2>/dev/null)" = true ] \
        && ok "$home is trusted" || fix "$home isn't trusted: run \`cd $home && claude\`, trust it, /exit (INSTALL.md step 6)"
      plugins=$(claude plugin list --json 2>/dev/null) || plugins='[]'
    fi
    (. "$hex/bin/settings"; [ -n "${TELEGRAM_BOT_TOKEN:-}" ] && curl -sf -m 10 "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/getMe" >/dev/null) \
      && ok "Telegram bot token works" || fix "TELEGRAM_BOT_TOKEN in $home/.env is missing or Telegram rejects it (INSTALL.md steps 3-4)"
    (. "$hex/bin/settings"; [ -n "${HEX_MAIN_THREAD:-}" ]) && ok "HEX_MAIN_THREAD is set" || fix "HEX_MAIN_THREAD isn't set in $home/.env (INSTALL.md step 4)"
    jq -e '.allowFrom | length > 0' "$home/state/telegram/access.json" >/dev/null 2>&1 \
      && ok "Telegram access list" || fix "nobody may talk to hex: write $home/state/telegram/access.json (INSTALL.md step 4)"
    managed=/etc/claude-code/managed-settings.json
    [ "$(uname)" = Darwin ] && managed="/Library/Application Support/ClaudeCode/managed-settings.json"
    for channel in telegram discord buzz t3; do
      printf '%s\n' "${plugins:-[]}" | jq -e --arg id "$channel@hex" 'any(.[]; .id == $id)' >/dev/null || continue
      jq -e --arg plugin "$channel" '.channelsEnabled == true and any(.allowedChannelPlugins[]?; .plugin == $plugin and .marketplace == "hex")' "$managed" >/dev/null 2>&1 \
        && ok "$channel channel installed and allowed" || fix "$managed doesn't allow the $channel@hex channel (INSTALL.md step 5)"
    done
    printf '%s\n' "${plugins:-[]}" | jq -e 'any(.[]; .id == "telegram@hex")' >/dev/null || fix "the Telegram channel isn't installed: \`claude plugin install telegram@hex\` (INSTALL.md step 5)"
    [ -d "$home/memory" ] && ok "memory in $home/memory" || fix "no memory folder: run \`$hex/bin/hex init\`"
    running && ok "hub running (pid $(cat "$pidfile"))" || fix "the hub isn't running: \`$hex/bin/hex start\` (INSTALL.md step 7)"
    free=$(df -Pk "$home" | awk 'NR == 2 { print int($4 / 1048576) }')
    [ "${free:-0}" -ge 5 ] && ok "$free GB free on disk" || fix "only ${free:-0} GB free on disk: sessions and backups need room"
    [ "$problems" -eq 0 ] && echo "hex looks healthy" || { echo "$problems to fix"; exit 1; }
    ;;
  *)
    echo "usage: hex init|start|stop|restart|status|doctor|run|acp|deliver|task|tasks|hold|holds|questions|pins|threads|running|message|profile|log|recall|watch" >&2
    exit 2
    ;;
esac
