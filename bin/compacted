#!/bin/sh
input=$(cat)
session=$(printf '%s' "$input" | jq -r .session_id)
here=$(cd "$(dirname "$0")" && pwd)
export LC_ALL=C

# A session started before the wake hooks ran on compact still calls `compacted memory` and `compacted turns`.
[ "${1:-}" = memory ] && exit 0

# After a compaction, the end of the conversation word for word, cut at a turn to fit a hook's 10,000 characters.
room=9000

# A hub's session keeps its thread's messages, a terminal session its own.
log="${TMPDIR:-/tmp}/hex-turns-$session.md"
"$here/hex" log --last 200 --taken -- "${HEX_THREAD:-$session}" > "$log" 2>/dev/null && [ -s "$log" ] || { rm -f "$log"; exit 0; }
start=$(awk -v room="$room" '
  { line[NR] = $0; turn[NR] = /^## .+ · \[[^]]+\]/ }
  END {
    for (i = NR; i > 0 && size + length(line[i]) + 1 <= room; i--) size += length(line[i]) + 1
    for (j = i + 1; j <= NR && !turn[j]; j++) ;
    print j <= NR ? j : i + 1
  }' "$log")
if [ "$start" = 1 ]; then
  echo "Your context was just compacted. This is the whole conversation so far, word for word, from \`.hex/bin/hex log\`; the summary above has what you did in the turn in progress:"
else
  echo "Your context was just compacted. This is the end of the conversation, word for word, from \`.hex/bin/hex log\`; \`.hex/bin/hex log -- '${HEX_THREAD:-$session}'\` has the earlier messages, and the summary above has what you did in the turn in progress."
fi
echo
tail -n +"$start" "$log"
rm -f "$log"
