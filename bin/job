#!/usr/bin/env bun
// job <unit> [<thread>] <command...>: run a long job as its own systemd unit, so hex restarts don't
// stop it, and wake the thread that owns it when it ends. The owner is the hex session that runs it,
// or <thread>: an open thread's key or <app>:<key> id (hex threads). The job's Claude Code
// sessions carry their owner in HEX_OWNER, so the voice app's Tasks shows them under it, and are
// named <owner>/<unit> unless they name themselves. A job whose command is claude runs as a hex
// session in the folder it was started from, through the launcher the hub starts sessions with,
// so it has hex's rules, memory and hooks.
import { $ } from "bun"
import { basename } from "node:path"
import { served } from "../hub/running.ts"
import { open, stateDir } from "../hub/store.ts"

const [mode, ...rest] = process.argv.slice(2)
const store = open(stateDir())

// The open thread a word names, by its key or id, as its id.
function named(word: string): string | undefined {
  const key = store.key(word)
  const thread = store.threads({ open: true }).find(({ thread }) => thread === key)
  return thread && `${thread.app}:${key}`
}

if (mode === "--ended") {
  const [unit, owner] = rest as [string, string]
  const key = store.key(owner)
  if (!store.threads().some(({ thread }) => thread === key)) {
    console.error(`job: ${unit} ended, but no app has the thread ${owner} to wake`)
    process.exit(1)
  }
  const result = process.env.SERVICE_RESULT ?? "unknown"
  const status = process.env.EXIT_STATUS ?? "?"
  const content = `[job] ${unit} ended: ${result} (exit ${status}). Check its output and report it.`
  await $`${import.meta.dir}/hex deliver job:${unit}@${process.env.INVOCATION_ID ?? Date.now()} --to=${key} --user=job ${content}`
} else {
  const given = rest.length > 1 ? named(rest[0]!) : undefined
  const owner = given ?? served()
  const command = given ? rest.slice(1) : rest
  if (!mode || !command.length) {
    console.error("usage: job <unit> [<thread>] <command...>")
    process.exit(2)
  }
  if (!owner) {
    console.error("job: run it from a hex session, or name the thread that owns it")
    process.exit(2)
  }
  const key = store.key(owner)
  const name = `${store.names()[key] ?? key}/${mode}`
  const agent = basename(command[0]!) === "claude"
  if (!agent && /(^|[\s;&|(/])claude(\s|$)/.test(command.join(" "))) console.error(`job: to run Claude as a hex session, start it from its folder as: job ${mode} claude -p "<prompt>"`)
  const run = agent ? [`${import.meta.dir}/session`, "-n", name, ...command.slice(1)] : command
  // Like claude -p, the job reads what comes on stdin after its prompt.
  const piped = agent && !process.stdin.isTTY ? await Bun.stdin.text() : ""
  const input = piped ? ["-p", `StandardInputData=${Buffer.from(piped).toString("base64")}`] : []
  const env = ["PATH", "CLAUDE_CONFIG_DIR"].filter((name) => process.env[name]).flatMap((name) => ["-E", `${name}=${process.env[name]}`])
  await $`systemd-run --user --unit=${mode} --same-dir ${input} --collect ${env} -E CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 -E HEX_OWNER=${owner} -E CLAUDE_CODE_SESSION_NAME=${name} -p ${verbatim(`ExecStopPost=${process.execPath} ${import.meta.path} --ended ${mode} ${owner}`)} -- ${run.map(verbatim)}`
}

// systemd expands $VARIABLE in a unit's command lines, which would rewrite a thread's name or prompt;
// $$ is a plain $ on every version.
function verbatim(arg: string) {
  return arg.replaceAll("$", () => "$$")
}
