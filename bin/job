#!/usr/bin/env bun
// job <unit> [<thread>] <command...>: run a long job as its own systemd unit, so hex restarts don't
// stop it, and wake the thread that owns it when it ends. The owner is the hex session that runs it,
// or <thread>: a key from one app's state/<app>/threads.json, or <app>:<key>. The job's Claude Code
// sessions carry their owner in HEX_OWNER, so the voice app's Tasks shows them under it, and are
// named <owner>/<unit> unless they name themselves. A job whose command is claude runs as a hex
// session: in the hex folder, through the launcher the hub starts sessions with, so it has hex's
// rules, memory and hooks.
// One started in another folder gets that folder too, with its CLAUDE.md.
import { $ } from "bun"
import { readdirSync, readFileSync, realpathSync } from "node:fs"
import { basename, resolve } from "node:path"

const home = resolve(import.meta.dir, "../..")
const state = `${home}/state/`
const [mode, ...rest] = process.argv.slice(2)

function threadsOf(app: string): Record<string, { name?: string }> {
  try {
    return JSON.parse(readFileSync(`${state}${app}/threads.json`, "utf8")) ?? {}
  } catch {
    return {}
  }
}

function apps() {
  try {
    return readdirSync(state).filter((app) => !app.startsWith(".")).sort()
  } catch {
    return []
  }
}

// The thread a word names, as <app>:<key>. A bare key must be in exactly one app's list: one in two
// is a stray, and guessing between them sends wakes to the wrong session.
function named(word: string, here?: { app: string; key: string }): string | undefined {
  if (here && word === here.key) return `${here.app}:${word}`
  const split = word.indexOf(":")
  const app = word.slice(0, split)
  if (split > 0 && apps().includes(app) && word.slice(split + 1) in threadsOf(app)) return word
  const holders = apps().filter((app) => word in threadsOf(app))
  if (holders.length > 1) {
    console.error(`job: ${word} is a thread in ${holders.join(" and ")}; name it as <app>:${word}`)
    process.exit(2)
  }
  return holders.length ? `${holders[0]}:${word}` : undefined
}

// The hex session running this, from what its hub gave it, or the owner of the job it runs in.
function caller() {
  const app = process.env.HEX_CHANNEL?.match(/^plugin:([^@]+)/)?.[1]
  const key = process.env.HEX_THREAD
  if (app && key) return { app, key }
  return process.env.HEX_OWNER?.includes(":") ? parts(process.env.HEX_OWNER) : undefined
}

function parts(owner: string) {
  const split = owner.indexOf(":")
  return { app: owner.slice(0, split), key: owner.slice(split + 1) }
}

if (mode === "--ended") {
  const [unit, thread] = rest as [string, string]
  const owner = named(thread)
  if (!owner) {
    console.error(`job: ${unit} ended, but no app has the thread ${thread} to wake`)
    process.exit(1)
  }
  const { app, key } = parts(owner)
  const result = process.env.SERVICE_RESULT ?? "unknown"
  const status = process.env.EXIT_STATUS ?? "?"
  const content = `[job] ${unit} ended: ${result} (exit ${status}). Check its output and report it.`
  // Kept as from its owner's app, so only that app's hub delivers it, even to a key two apps share.
  await $`${import.meta.dir}/hex deliver ${app}:job:${unit}@${process.env.INVOCATION_ID ?? Date.now()} --to=${key} --user=job ${content}`
} else {
  const here = caller()
  const given = rest.length > 1 ? named(rest[0]!, here) : undefined
  const owner = given ?? (here && `${here.app}:${here.key}`)
  const command = given ? rest.slice(1) : rest
  if (!mode || !command.length) {
    console.error("usage: job <unit> [<thread>] <command...>")
    process.exit(2)
  }
  if (!owner) {
    console.error("job: run it from a hex session, or name the thread that owns it")
    process.exit(2)
  }
  const name = `${threadsOf(parts(owner).app)[parts(owner).key]?.name ?? parts(owner).key}/${mode}`
  const agent = basename(command[0]!) === "claude"
  if (!agent && /(^|[\s;&|(/])claude(\s|$)/.test(command.join(" "))) console.error(`job: to run Claude as a hex session, start it as: job ${mode} claude -p "<prompt>"`)
  const folder = process.cwd()
  const away = realpathSync(folder) !== realpathSync(home)
  const run = agent ? [`${import.meta.dir}/session`, "-n", name, ...command.slice(1), ...(away ? ["--add-dir", folder] : [])] : command
  // Like claude -p, the job reads what comes on stdin after its prompt.
  const piped = agent && !process.stdin.isTTY ? await Bun.stdin.text() : ""
  const told = agent ? piped + (away ? `\n\nThis work is in ${folder}: run its commands there.` : "") : ""
  const input = told ? ["-p", `StandardInputData=${Buffer.from(told).toString("base64")}`] : []
  const env = ["PATH", "CLAUDE_CONFIG_DIR"].filter((name) => process.env[name]).flatMap((name) => ["-E", `${name}=${process.env[name]}`])
  // systemd expands ${VARIABLE} in a unit's command, which would rewrite a thread's name or prompt;
  // 254 added --expand-environment to turn that off, and older ones pass it as given.
  const verbatim = (await $`systemd-run --help`.text()).includes("--expand-environment") ? ["--expand-environment=no"] : []
  await $`systemd-run --user --unit=${mode} ${verbatim} ${agent ? `--working-directory=${home}` : "--same-dir"} ${input} --collect ${env} -E CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 -E HEX_OWNER=${owner} -E CLAUDE_CODE_SESSION_NAME=${name} -p ${`ExecStopPost=${process.execPath} ${import.meta.path} --ended ${mode} ${owner}`} -- ${run}`
}
