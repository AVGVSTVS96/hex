#!/usr/bin/env bun
import { existsSync, readFileSync, writeFileSync } from 'fs'
import { tmpdir } from 'os'
import { join, resolve } from 'path'
import { clip, owners } from '../hub/notes.ts'
import { open } from '../hub/store.ts'

// Each of the owner's asks becomes a task in their words. When a turn ends with messages of theirs
// this session took that no task quotes, it goes on once with them in front of it, to make the tasks;
// the reply went out already, so they wait on nothing.

const state = process.env.HEX_STORE || resolve(import.meta.dir, '../../state')
const { session_id, stop_hook_active } = JSON.parse(readFileSync(0, 'utf8'))
if (stop_hook_active || !session_id || !existsSync(join(state, 'hex.db'))) process.exit(0)

const store = open(state)
const seen = join(process.env.TMPDIR || tmpdir(), `hex-asked-${session_id}`)
// Without a mark, as in a session resumed after a restart, only the message that woke it counts.
const took = existsSync(seen) ? store.took(session_id, readFileSync(seen, 'utf8')) : store.took(session_id, '').slice(-1)
const quoted = store.db.query('select 1 from words where message = ?')
const asks = owners(took).filter(row => !row.meta?.reaction && !row.meta?.button && !row.meta?.vote && !row.meta?.deleted && !quoted.get(row.key))
if (took.length) writeFileSync(seen, took.at(-1)!.taken!.at)
if (!asks.length) process.exit(0)

console.log(
  JSON.stringify({
    decision: 'block',
    reason: `No task quotes these messages from the owner yet:\n\n${asks.map(row => `[${row.key}] ${clip(row.body, 600)}`).join('\n\n')}\n\nEach one that asks for something becomes a task: \`.hex/bin/hex task new <key>\`, with \`--quote "<part>"\` when only part of it is the ask and \`--done-when\` for the outcome they're after. One that adds to a task goes on it with \`hex task add <task> <key>\`. The rest need nothing. They have your reply already, so send nothing more.`,
  }),
)
