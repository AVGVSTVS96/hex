#!/bin/sh
input=$(cat)
transcript=$(printf '%s' "$input" | jq -r .transcript_path)
session=$(printf '%s' "$input" | jq -r .session_id)
[ -f "$transcript" ] || exit 0

if [ "${1:-}" = new ]; then
  seen="${XDG_RUNTIME_DIR:-/tmp}/hex-log-$session"
  from=$(cat "$seen" 2>/dev/null || echo 0)
  size=$(wc -c <"$transcript")
  echo "$size" >"$seen"
  tail -c +"$((from + 1))" "$transcript" | grep -q -e '"role":"user","content":"' -e '"type":"queued_command"' -e '__reply","input":' || exit 0
fi

said=terminal
case "${HEX_CHANNEL:-}" in plugin:t3@*) said=t3 ;; esac
started=$(jq -r 'select(.timestamp) | .timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdate | strflocaltime("%Y-%m-%d")' "$transcript" | head -n 1)
dir="$(cd "$(dirname "$0")/../.." && pwd)/log"
typist=me
[ -n "${HEX_THREAD:-}${HEX_OWNER:-}" ] && [ -z "${HEX_MAIN:-}" ] && dir="$dir/threads" typist=hex
out="$dir/$started-$(printf '%s' "$session" | cut -c 1-8).md"
mkdir -p "$dir"

if command -v flock >/dev/null; then exec 9<"$dir"; flock 9; fi

body=$(jq -r --arg typist "$typist" '
    def clock: .timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdate | strflocaltime("%Y-%m-%d %H:%M");
    def block($e; $who; $via; $text): "## \($who) · \($via) · \($e | clock)\n\n\($text)\n";
    def texts: if type == "string" then . else .[] | select(.type == "text") | .text end;
    def heard($e; $text):
      if ($text | startswith("<channel")) then
        ($text | capture("^<channel(?<a>[^>]*)>").a) as $tag
        | ([$tag | capture("^ source=\"(plugin:)?(?<app>[a-z0-9]+)").app] | first // "chat") as $app
        | block($e; if ($tag | test(" user_id=")) then "me" else [$tag | capture(" user=\"(?<u>[^\"]+)\"").u] | first // (if $app == "t3" then "me" else "hex" end) end;
          $app;
          ([$text | capture("^<channel[^>]*>(?<m>[\\s\\S]*)</channel>").m] | first // $text) | gsub("^\\s+|\\s+$"; ""))
      elif ($text | test("^<(local-command|command-|system-reminder|task-notification)")) then empty
      else block($e; $typist; "terminal"; $text) end;

    select(.isSidechain != true and .isCompactSummary != true and .origin.kind != "plugin" and (.isMeta != true or .origin.kind == "channel")) | . as $e
    | if .type == "user" then (.message.content | texts) as $t | heard($e; $t)
      elif .type == "attachment" and .attachment.type == "queued_command" then (.attachment.prompt | texts) as $t | heard($e; $t)
      elif .type == "assistant" then
        .message.content[]
        | if .type == "text" and (.text | test("^\\s*HEARTBEAT_OK\\s*$") | not) then block($e; "assistant"; $said; .text)
          elif .type == "tool_use" and (.name | test("^mcp__plugin_[a-z]+_[a-z]+__reply$")) then block($e; "assistant"; (.name | capture("^mcp__plugin_(?<app>[a-z]+)_").app); .input.text)
          else empty end
      else empty end
  ' --arg said "$said" "$transcript")
[ -n "$body" ] || exit 0

printf '# %s · session %s\n\n%s\n' "$started" "$session" "$body" > "$out.$$" && mv "$out.$$" "$out" || exit
[ "${1:-}" != path ] || echo "$out"
