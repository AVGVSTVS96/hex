#!/usr/bin/env bun
// away <machine> <environment> <name> <claude args...>: runs an agent job as a T3 Code thread on another machine,
// through this machine's T3 Code and its link to that one, so it starts the way T3 starts Claude Code, and follows it
// the way `t3 thread start --wait` does: until its run ends, then prints its answer; it stops the thread if the job
// stops. Having started nothing, it exits 76 when the job can't run there (claude flags a thread has no place for, no
// Claude there, a link that's gone) and 77 when T3 Code, here or there, doesn't answer; bin/place then tries the next
// machine.
import { readFileSync } from 'node:fs'
import { homedir, hostname, userInfo } from 'node:os'
import { join } from 'node:path'

const [machine, environmentId, name, ...args] = process.argv.slice(2) as [string, string, string, ...string[]]
const home = join(import.meta.dir, '../..')
const [ELSEWHERE, UNREACHABLE] = [76, 77]
const quit = (code: number, why: string): never => {
  console.error(`away: ${name} can't run on ${machine}: ${why}`)
  process.exit(code)
}

// The claude flags a thread has a place for; a job with any other runs where its flags mean something.
let model: string | undefined
let effort: string | undefined
const words: string[] = []
for (let at = 0; at < args.length; at++) {
  const arg = args[at]!
  if (arg === '-p' || arg === '--print') continue
  else if (arg === '--model') model = args[++at]
  else if (arg === '--effort') effort = args[++at]
  else if (/^--?[A-Za-z][\w-]*(=.*)?$/.test(arg)) quit(ELSEWHERE, `${arg} has no place in a T3 Code thread`)
  else words.push(arg)
}
const piped = process.stdin.isTTY ? '' : (await Bun.stdin.text()).trim()
const asked = [words.join(' '), piped].filter(Boolean).join('\n\n')
if (!asked) quit(ELSEWHERE, 'the job has no prompt')

function parse(text: string): any {
  try {
    return JSON.parse(text)
  } catch {}
}
// T3's own split (RemoteDelegation): a revoked link or a thread or run that's gone is final, and so is a request it
// can't take. A fault on this machine is its own (Local), so it isn't charged to the other one. The other machine
// asleep, a dropped route or T3 Code restarting is retried.
const FINAL = ['capability_denied', 'thread_not_found', 'run_not_found', 'invalid_request']
class Final extends Error {}
class Local extends Error {}
const here = (why: string) => new Local(`T3 Code on ${hostname()}, this machine: ${why}`)

// This machine's T3 Code /mcp, signed in once; its MCP tools are the only calls T3 forwards over a link. A refused
// token is renewed once. Signing in runs beside signals, so a stop is never held up behind it.
type Headers = Record<string, string>
let headers: Promise<Headers> | undefined
async function signIn(refused?: string): Promise<Headers> {
  const env = { ...process.env, ...(refused && { T3_REFUSED: refused }) }
  const helper = Bun.spawn([join(import.meta.dir, 't3-mcp-headers'), ...(refused ? ['--refresh'] : [])], { cwd: home, env, stdout: 'pipe', stderr: 'pipe', timeout: 180_000, killSignal: 'SIGKILL' })
  const [out, err, code] = await Promise.all([new Response(helper.stdout).text(), new Response(helper.stderr).text(), helper.exited])
  const signed = parse(out)
  // Retried like a call that didn't answer: a sign-in can wait on another job's, or on T3 Code restarting.
  if (code !== 0 || typeof signed?.Authorization !== 'string') throw new Error(`T3 Code on ${hostname()}, this machine: couldn't sign in: ${err.trim() || 'no sign-in printed'}`)
  return { ...signed, 'content-type': 'application/json', accept: 'application/json, text/event-stream' }
}
const signedIn = (refused?: string) =>
  (headers = signIn(refused).catch(error => {
    headers = undefined
    throw error
  }))
const url = (() => {
  try {
    return `http://127.0.0.1:${JSON.parse(readFileSync(join(homedir(), '.t3/userdata/server-runtime.json'), 'utf8')).port}/mcp`
  } catch {
    quit(UNREACHABLE, here("it isn't running (no ~/.t3/userdata/server-runtime.json)").message)
  }
})()!
// One MCP session at a time, each request with its own id, since a stop can run beside a wait.
let session: string | undefined
let opening: Promise<void> | undefined
let ids = 0
async function post(body: object, patience = 120_000, renewed = false): Promise<Response> {
  const using = headers ?? signedIn()
  const used = await Promise.race([using, Bun.sleep(patience).then(() => Promise.reject(new Error(`T3 Code on ${hostname()}, this machine: signing in took over ${patience / 1000} s`)))])
  const answer = await fetch(url, { method: 'POST', headers: { ...used, ...(session && { 'mcp-session-id': session }) }, body: JSON.stringify({ jsonrpc: '2.0', ...body }), signal: AbortSignal.timeout(patience) })
  if (answer.status === 401 && !renewed) {
    if (headers === using) signedIn(used.Authorization!.replace(/^Bearer /, ''))
    return post(body, patience, true)
  }
  // A refused sign-in, or a request T3 Code turns down, won't change by asking again; anything else might.
  if (answer.status >= 400 && answer.status < 500 && ![404, 408, 429].includes(answer.status)) throw here(`HTTP ${answer.status} ${await answer.text()}`)
  if (!answer.ok) throw Object.assign(new Error(`HTTP ${answer.status} from T3 Code on ${hostname()}`), { status: answer.status })
  return answer
}
const open = () =>
  (opening ??= (async () => {
    session = undefined
    session = (await post({ id: ++ids, method: 'initialize', params: { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'hex-away', version: '1' } } })).headers.get('mcp-session-id') ?? undefined
    await post({ method: 'notifications/initialized' })
  })().catch(error => {
    opening = undefined
    throw error
  }))
// reached() runs once the call may have reached the other machine: T3 Code here took it and didn't answer with a
// refusal that started nothing.
async function call(tool: string, input: Record<string, unknown>, { reached, patience }: { reached?: () => void; patience?: number } = {}): Promise<any> {
  await open()
  const body = { id: ++ids, method: 'tools/call', params: { name: tool, arguments: { environmentId, ...input } } }
  const answer = await post(body, patience).catch(error => {
    if (error.name === 'TimeoutError' || error.status >= 500) reached?.()
    throw error
  })
  const raw = await answer.text().catch(error => {
    reached?.()
    throw error
  })
  // Streamable HTTP may answer as an event stream, whose last data line is the reply.
  const reply = answer.headers.get('content-type')?.startsWith('text/event-stream') ? (raw.split('\n').filter(line => line.startsWith('data:')).at(-1)?.slice(5) ?? '') : raw
  const { result, error } = parse(reply) ?? {}
  const text = result?.content[0]?.text ?? ''
  if (result?.isError && FINAL.includes(parse(text)?.code)) throw new Final(`${tool}: ${text}`)
  // JSON-RPC's own refusals (parse error, invalid request, unknown method, invalid params) come before the tool runs.
  if (!(error && [-32700, -32600, -32601, -32602].includes(error.code))) reached?.()
  if (error) throw here(`${tool}: ${error.message}`)
  if (!result) throw new Error(`${tool}: an answer that is not JSON`)
  if (result.isError) throw new Error(`${tool}: ${text}`)
  return result.structuredContent ?? parse(text)
}

let threadId: string | undefined
let stopping = false
let stopped: () => void
const stopSignal = new Promise<void>(resolve => (stopped = resolve))
let sent = false
let launching = false
const requestId = `hex-job-${name}-${machine}-${process.env.INVOCATION_ID ?? process.pid}`
// Within systemd's 90 s to stop a unit.
const stop = (reason: string) => call('t3_thread_interrupt', { threadId, stop: true, reason }, { patience: 30_000 }).catch(error => console.error(`away: couldn't stop the thread: ${error.message}`))
for (const signal of ['SIGTERM', 'SIGINT'] as const)
  process.on(signal, () => {
    stopping = true
    stopped()
    if (threadId) void stop(`hex stopped the job ${name}`).then(() => process.exit(143))
  })
// A job stopped while starting ends; a launch that may have reached the other machine is asked for again, which gets
// back the thread it started, if any, so it can be stopped.
let abandoning: Promise<never> | undefined
const abandon = () => (abandoning ??= leave())
async function leave(): Promise<never> {
  // Started after all: the signal handler stops it.
  if (threadId) return new Promise<never>(() => {})
  const started = (sent || launching) && (await Promise.race([launch(20_000).catch(() => undefined), Bun.sleep(25_000)]))
  if (started) {
    threadId = started.threadId
    await stop(`hex stopped the job ${name}`)
  } else if (sent || launching) console.error(`away: ${name} stopped while starting; a thread may have started on ${machine} under ${requestId}`)
  process.exit(143)
}
// A call is retried with backoff until it's final or patience runs out. A stop ends the retrying: before the thread
// exists, the job is abandoned; after, the signal handler stops the thread.
async function persist<T>(what: () => Promise<T>, patience = Infinity): Promise<T> {
  const until = Date.now() + patience
  for (let wait = 5_000; ; wait = Math.min(wait * 2, 120_000)) {
    try {
      return await what()
    } catch (error) {
      if (stopping && threadId) return new Promise<never>(() => {})
      if (stopping) await abandon()
      if (error instanceof Final || error instanceof Local || Date.now() + wait > until) throw error
      console.error(`away: ${(error as Error).message}; trying again in ${wait / 1000} s`)
      opening = undefined
      await Promise.race([Bun.sleep(wait), stopSignal])
      if (stopping && threadId) return new Promise<never>(() => {})
      if (stopping) await abandon()
    }
  }
}

// This machine's sign-in first, so its fault is named as its own at once.
await signedIn().catch((error: Error) => quit(UNREACHABLE, error.message))
// The first forwarded call starts nothing, so a machine that doesn't answer it in 5 minutes is left for the next one.
const offered = await persist(() => call('orchestrator_capabilities', {}), 300_000).catch((error: Error) => quit(error instanceof Final ? ELSEWHERE : UNREACHABLE, error.message))
if (stopping) process.exit(143)
// A model goes by its alias, like opus, or its id, as that machine's Claude lists it, newest first; with none, the one hex's sessions run.
const configured = (path: string) => {
  try {
    return parse(readFileSync(path, 'utf8'))?.model as string | undefined
  } catch {}
}
const wanted = model ?? configured(join(home, '.claude/settings.json')) ?? configured(join(homedir(), '.claude/settings.json')) ?? 'opus'
const claude = (offered.providers as { providerInstanceId: string; models: { id: string }[] }[]).find(provider => provider.providerInstanceId === 'claudeAgent')
const chosen = claude?.models.find(({ id }) => id === wanted) ?? claude?.models.filter(({ id }) => id.includes(wanted)).sort((a, b) => b.id.localeCompare(a.id))[0]
if (!chosen) quit(ELSEWHERE, claude ? `its Claude has no ${wanted}` : 'its T3 Code has no Claude')

const identity = Bun.spawnSync([join(import.meta.dir, 'identity'), home]).stdout.toString()
const message = `${identity}

You are running on ${machine}, in a T3 Code thread hex started there because ${hostname()}, where hex runs, was short on room. The job was started in ${process.cwd()} on ${hostname()}. Your folder ${home}, the files under it and every other path on ${hostname()} are reached with \`ssh ${userInfo().username}@${hostname()} '<command>'\`, hex's commands included. Work in this machine's own checkouts: clone or pull a repo here, and push what you commit.

${asked}`

// A launch that fails on the way is retried, and the same clientRequestId gets back the thread it may have started.
// Once one may have reached the other machine, a launch that keeps failing fails the job, rather than moving on to a
// machine where it could run twice.
const launch = (patience?: number) =>
  call(
    't3_thread_launch',
    {
      title: name,
      scratch: true,
      message,
      runtimeMode: 'full-access',
      modelSelection: { provider: 'claudeAgent', model: chosen.id, options: effort ? [{ id: 'effort', value: effort }] : [] },
      clientRequestId: requestId,
    },
    { reached: () => (sent = true), patience },
  )
// A stop while a launch is on its way doesn't wait for its answer.
const launched = await persist(async () => {
  launching = true
  try {
    return await Promise.race([launch(), stopSignal.then(abandon)])
  } finally {
    launching = false
  }
}, 1_800_000).catch((error: Error) => {
  if (!sent && error instanceof Final) quit(ELSEWHERE, error.message)
  if (!sent) quit(UNREACHABLE, error.message)
  console.error(`away: ${name} couldn't start on ${machine}: ${error.message}; a thread may have started there under ${requestId}`)
  process.exit(1)
})
threadId = launched.threadId as string
if (stopping) await stop(`hex stopped the job ${name}`).then(() => process.exit(143))
console.log(`${name} runs on ${machine} as T3 Code thread ${launched.link}`)

// As `t3 thread start --wait` does (T3's cli/thread.ts waitForRun): a run that hasn't ended while its thread has a
// pending request, checked once more, needs an answer a job can't give. With Claude, a pending request holds its turn.
const runId = launched.runId ?? undefined
const ENDED = ['completed', 'interrupted', 'failed', 'cancelled', 'rolled_back', ...(runId ? [] : ['idle'])]
async function follow(): Promise<number> {
  const slice = (timeoutMs: number) => persist(() => call('t3_thread_wait', { threadId, runId, timeoutMs }))
  let waited = await slice(50_000)
  while (!ENDED.includes(waited.status)) {
    const { thread } = await persist(() => call('t3_thread_read', { threadId, limit: 1, runLimit: 1 }))
    const pending = thread.pendingRequestCount > 0 || waited.hasPendingQuestion || waited.pendingApproval
    if (pending && !ENDED.includes((waited = await slice(1)).status)) {
      const { requestIds } = await call('t3_pending_request', { action: 'list', threadId }).catch(() => ({}))
      const read = requestIds?.length ? await call('t3_pending_request', { action: 'read', threadId, requestId: requestIds[0] }).catch(() => undefined) : undefined
      await stop(`the job ${name} has nobody to answer`)
      const question = (read?.questions as { question: string }[] | undefined)?.map(({ question }) => question).join(' ')
      console.log(`${name} stopped on ${machine} at a question, which a job can't answer: ${question ?? `see ${launched.link}`}`)
      return 1
    }
    // A wait that comes back early without an end gets a pause, so the two machines aren't asked in a tight loop.
    if (!waited.timedOut) await Bun.sleep(5_000)
    if (!ENDED.includes(waited.status)) waited = await slice(50_000)
  }
  if (stopping) return 143
  let last: { text: string } | undefined
  for (let after: number | undefined, more = true; more; ) {
    const page = await persist(() => call('t3_thread_read', { threadId, view: 'messages', limit: 100, maxCharsPerItem: 50_000, afterPosition: after }))
    last = (page.items as { type: string; text: string }[]).filter(item => item.type === 'assistant_message').at(-1) ?? last
    ;[after, more] = [page.nextPosition, page.hasMore]
  }
  console.log(last?.text ?? `${name} ended on ${machine} with no answer`)
  return waited.status === 'completed' ? 0 : 1
}
// A thread this job can no longer follow is stopped, so nothing runs there unwatched.
const code = await follow().catch(async (error: Error) => {
  console.error(`away: ${error.message}; stopping the thread`)
  await stop(`hex lost track of the job ${name}`)
  return 1
})
if (!stopping) process.exit(code)
