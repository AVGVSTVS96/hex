#!/usr/bin/env bun
// away <machine> <environment> <name> <claude args...>: runs an agent job as a T3 Code thread on another machine,
// through this machine's T3 Code and its link to that one, so it starts the way T3 starts Claude Code, and follows it
// the way `t3 thread start --wait` does: until its run ends, then prints its answer; it stops the thread if the job
// stops. Having started nothing, it exits 76 when the job can't run there (claude flags a thread has no place for, no
// Claude there, a link that's gone) and 77 when T3 Code doesn't answer; bin/place then tries the next machine.
import { readFileSync } from 'node:fs'
import { homedir, hostname, userInfo } from 'node:os'
import { join } from 'node:path'

const [machine, environmentId, name, ...args] = process.argv.slice(2) as [string, string, string, ...string[]]
const home = join(import.meta.dir, '../..')
const [ELSEWHERE, UNREACHABLE] = [76, 77]
const quit = (code: number, why: string): never => {
  console.error(`away: ${name} can't run on ${machine}: ${why}`)
  process.exit(code)
}

// The claude flags a thread has a place for; a job with any other runs where its flags mean something.
let model: string | undefined
let effort: string | undefined
const words: string[] = []
for (let at = 0; at < args.length; at++) {
  const arg = args[at]!
  if (arg === '-p' || arg === '--print') continue
  else if (arg === '--model') model = args[++at]
  else if (arg === '--effort') effort = args[++at]
  else if (/^--?[A-Za-z][\w-]*(=.*)?$/.test(arg)) quit(ELSEWHERE, `${arg} has no place in a T3 Code thread`)
  else words.push(arg)
}
const piped = process.stdin.isTTY ? '' : (await Bun.stdin.text()).trim()
const asked = [words.join(' '), piped].filter(Boolean).join('\n\n')
if (!asked) quit(ELSEWHERE, 'the job has no prompt')

// This machine's T3 Code, reached as hex's sessions reach it: the t3-code server in the hex folder's .mcp.json. Its
// MCP tools are the only calls T3 forwards over a link to another machine.
function parse(text: string): any {
  try {
    return JSON.parse(text)
  } catch {}
}
const server = (() => {
  try {
    return parse(readFileSync(join(home, '.mcp.json'), 'utf8'))?.mcpServers?.['t3-code'] as { url?: string; headersHelper?: string } | undefined
  } catch {}
})()
if (!server?.url || !server.headersHelper) quit(ELSEWHERE, `${home}/.mcp.json has no t3-code server`)
// T3's own split (RemoteDelegation): a revoked link or a thread or run that's gone is final, and so is a request it
// can't take; the other machine asleep, a dropped route or T3 Code restarting is retried.
const FINAL = ['capability_denied', 'thread_not_found', 'run_not_found', 'invalid_request']
class Final extends Error {}
// Signed in once per session, so stopping a thread as the unit stops starts no process systemd would kill first.
let session: string | undefined
let headers: Record<string, string> | undefined
async function call(tool: string, input: Record<string, unknown>): Promise<any> {
  if (!session) {
    const helper = Bun.spawnSync(['sh', '-c', server!.headersHelper!.replaceAll('${HOME}', homedir())], { cwd: home })
    if (helper.exitCode !== 0) throw new Error(`couldn't sign in to T3 Code on ${hostname()}: ${helper.stderr.toString().trim()}`)
    headers = { ...parse(helper.stdout.toString()), 'content-type': 'application/json', accept: 'application/json, text/event-stream' }
  }
  const post = (body: object) => fetch(server!.url!, { method: 'POST', headers: { ...headers, ...(session && { 'mcp-session-id': session }) }, body: JSON.stringify({ jsonrpc: '2.0', ...body }), signal: AbortSignal.timeout(120_000) })
  if (!session) {
    session = (await post({ id: 0, method: 'initialize', params: { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'hex-away', version: '1' } } })).headers.get('mcp-session-id') ?? undefined
    await post({ method: 'notifications/initialized' })
  }
  const answer = await post({ id: 1, method: 'tools/call', params: { name: tool, arguments: { environmentId, ...input } } })
  if (!answer.ok) throw new Error(`${tool}: HTTP ${answer.status} from T3 Code on ${hostname()}`)
  // Streamable HTTP may answer as an event stream, whose last data line is the reply.
  const raw = await answer.text()
  const reply = answer.headers.get('content-type')?.startsWith('text/event-stream') ? (raw.split('\n').filter(line => line.startsWith('data:')).at(-1)?.slice(5) ?? '') : raw
  const { result, error } = parse(reply) ?? {}
  if (error) throw new Final(`${tool}: ${error.message}`)
  if (!result) throw new Error(`${tool}: an answer that is not JSON`)
  const text = result.content[0]?.text ?? ''
  if (result.isError) throw FINAL.includes(parse(text)?.code) ? new Final(`${tool}: ${text}`) : Object.assign(new Error(`${tool}: ${text}`), { answered: true })
  return result.structuredContent ?? parse(text)
}

let threadId: string | undefined
let stopping = false
const stop = (reason: string) => call('t3_thread_interrupt', { threadId, stop: true, reason }).catch(error => console.error(`away: couldn't stop the thread: ${error.message}`))
for (const signal of ['SIGTERM', 'SIGINT'] as const)
  process.on(signal, () => {
    stopping = true
    if (threadId) void stop(`hex stopped the job ${name}`).then(() => process.exit(143))
  })
// A call is retried with backoff until it's final or patience runs out; a job stopped before its thread exists just ends.
async function persist<T>(what: () => Promise<T>, patience = Infinity): Promise<T> {
  const until = Date.now() + patience
  for (let wait = 5_000; ; wait = Math.min(wait * 2, 120_000)) {
    try {
      return await what()
    } catch (error) {
      if (error instanceof Final || Date.now() + wait > until) throw error
      console.error(`away: ${(error as Error).message}; trying again in ${wait / 1000} s`)
      session = undefined
      await Bun.sleep(wait)
      if (stopping && !threadId) process.exit(143)
    }
  }
}

// The first call starts nothing, so a machine that doesn't answer it in 5 minutes is left for the next one.
const offered = await persist(() => call('orchestrator_capabilities', {}), 300_000).catch((error: Error) => quit(error instanceof Final ? ELSEWHERE : UNREACHABLE, error.message))
// A model goes by its alias, like opus, or its id, as that machine's Claude lists it, newest first; with none, the one hex's sessions run.
const configured = (path: string) => {
  try {
    return parse(readFileSync(path, 'utf8'))?.model as string | undefined
  } catch {}
}
const wanted = model ?? configured(join(home, '.claude/settings.json')) ?? configured(join(homedir(), '.claude/settings.json')) ?? 'opus'
const claude = (offered.providers as { providerInstanceId: string; models: { id: string }[] }[]).find(provider => provider.providerInstanceId === 'claudeAgent')
const chosen = claude?.models.find(({ id }) => id === wanted) ?? claude?.models.filter(({ id }) => id.includes(wanted)).sort((a, b) => b.id.localeCompare(a.id))[0]
if (!chosen) quit(ELSEWHERE, claude ? `its Claude has no ${wanted}` : 'its T3 Code has no Claude')

const identity = Bun.spawnSync([join(import.meta.dir, 'identity'), home]).stdout.toString()
const message = `${identity}

You are running on ${machine}, in a T3 Code thread hex started there because ${hostname()}, where hex runs, was short on room. The job was started in ${process.cwd()} on ${hostname()}. Your folder ${home}, the files under it and every other path on ${hostname()} are reached with \`ssh ${userInfo().username}@${hostname()} '<command>'\`, hex's commands included. Work in this machine's own checkouts: clone or pull a repo here, and push what you commit.

${asked}`

// A launch lost on the way is retried, and the same clientRequestId gets back the thread it may have started; one the
// other machine answered with a refusal won't change by asking again.
const launched = await persist(() =>
  call('t3_thread_launch', {
    title: name,
    scratch: true,
    message,
    runtimeMode: 'full-access',
    modelSelection: { provider: 'claudeAgent', model: chosen.id, options: effort ? [{ id: 'effort', value: effort }] : [] },
    clientRequestId: `hex-job-${name}-${process.env.INVOCATION_ID ?? process.pid}`,
  }).catch(error => {
    throw error.answered ? new Final(error.message) : error
  }),
).catch((error: Error) => quit(ELSEWHERE, error.message))
threadId = launched.threadId as string
if (stopping) await stop(`hex stopped the job ${name}`).then(() => process.exit(143))
console.log(`${name} runs on ${machine} as T3 Code thread ${launched.link}`)

// As `t3 thread start --wait` does (T3's cli/thread.ts waitForRun): a wait that comes back before its timeout is the
// run's end; one that times out on a thread with a pending request, checked once more, needs an answer a job can't give.
async function follow(): Promise<number> {
  const slice = (timeoutMs: number) => persist(() => call('t3_thread_wait', { threadId, runId: launched.runId, timeoutMs }))
  let waited = await slice(50_000)
  while (waited.timedOut) {
    const { thread } = await persist(() => call('t3_thread_read', { threadId, limit: 1, runLimit: 1 }))
    if (thread.pendingRequestCount > 0 && (await slice(1)).timedOut) {
      const { requestIds } = await call('t3_pending_request', { action: 'list', threadId }).catch(() => ({}))
      const read = requestIds?.length ? await call('t3_pending_request', { action: 'read', threadId, requestId: requestIds[0] }).catch(() => undefined) : undefined
      await stop(`the job ${name} has nobody to answer`)
      const question = (read?.questions as { question: string }[] | undefined)?.map(({ question }) => question).join(' ')
      console.log(`${name} stopped on ${machine} at a question, which a job can't answer: ${question ?? `see ${launched.link}`}`)
      return 1
    }
    waited = await slice(50_000)
  }
  let last: { text: string } | undefined
  for (let after: number | undefined, more = true; more; ) {
    const page = await persist(() => call('t3_thread_read', { threadId, view: 'messages', limit: 100, maxCharsPerItem: 50_000, afterPosition: after }))
    last = (page.items as { type: string; text: string }[]).filter(item => item.type === 'assistant_message').at(-1) ?? last
    ;[after, more] = [page.nextPosition, page.hasMore]
  }
  console.log(last?.text ?? `${name} ended on ${machine} with no answer`)
  return waited.status === 'completed' ? 0 : 1
}
// A thread this job can no longer follow is stopped, so nothing runs there unwatched.
process.exit(
  await follow().catch(async (error: Error) => {
    console.error(`away: ${error.message}; stopping the thread`)
    await stop(`hex lost track of the job ${name}`)
    return 1
  }),
)
