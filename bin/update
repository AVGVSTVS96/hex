#!/bin/sh
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
cd "$hex"

before=$(git rev-parse --short HEAD)
git fetch -q origin main
incoming=$(git rev-parse origin/main)

if [ "$(git rev-parse HEAD)" = "$incoming" ]; then
  echo "up to date at $before"
  exit 0
fi
if [ "$incoming" = "$(git rev-parse -q --verify refs/hex/bad || :)" ]; then
  echo "not updated: hex $(git rev-parse --short "$incoming") couldn't start here, so hex stays on $before"
  exit 1
fi

check="$hex/worktrees/check"
clean() {
  rm -rf "$check"
  git worktree prune
}
clean
trap clean EXIT
git worktree add -q --detach "$check" "$incoming"
if ! output=$("$check/bin/check" 2>&1); then
  printf '%s\n' "$output"
  echo "not updated: hex $(git rev-parse --short "$incoming") fails bin/check"
  exit 1
fi

git merge -q --ff-only "$incoming"
"$hex/bin/optmem"

if [ "$(jq -r '.memory.prompt // empty' "$home/schedules.json")" = 'Nightly memory pass, see "Memory" in .hex/HEX.md' ]; then
  jq 'del(.memory)' "$home/schedules.json" > "$home/schedules.json.new" && mv "$home/schedules.json.new" "$home/schedules.json"
fi

"$hex/bin/hex" restart
echo "updated hex $before..$(git rev-parse --short HEAD); the hub restarts on it once no call is live, and each session at its next rest"
