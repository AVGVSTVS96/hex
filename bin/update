#!/bin/sh
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
cd "$hex"

before=$(git rev-parse --short HEAD)
git pull -q --ff-only
"$hex/bin/optmem"

if [ "$(jq -r '.memory.prompt // empty' "$home/schedules.json")" = 'Nightly memory pass, see "Memory" in .hex/HEX.md' ]; then
  jq 'del(.memory)' "$home/schedules.json" > "$home/schedules.json.new" && mv "$home/schedules.json.new" "$home/schedules.json"
fi

git -C channels fetch -q origin main
current=$(git -C channels rev-parse HEAD)
incoming=$(git -C channels rev-parse origin/main)
if [ "$current" != "$incoming" ]; then
  check=$(mktemp -d)
  trap 'git -C "$hex/channels" worktree remove --force "$check" 2>/dev/null; rm -rf "$check"' EXIT
  git -C channels worktree add -q --detach "$check" "$incoming"
  if ! output=$(PYTHONDONTWRITEBYTECODE=1 "$check/scripts/verify" 2>&1); then
    printf '%s\n' "$output"
    echo "channels not updated: $(git -C channels rev-parse --short "$incoming") fails scripts/verify"
    exit 1
  fi
  git -C channels checkout -q --detach "$incoming"
fi

after=$(git rev-parse --short HEAD)
if [ "$before" = "$after" ] && [ "$current" = "$incoming" ]; then
  echo "up to date at $after"
  exit 0
fi

# A restart cuts off whatever a session is doing, so the hub and every session restart
# on the new code once none of them is busy, this one included once its turn ends.
# Where there's systemd the wait gets a unit of its own: run from a session or from
# a systemd-run unit, a background wait ends when that does.
restart='
  until claude agents --json | jq -e --arg home "$1" "all(.[]; .cwd != \$home or .status != \"busy\")" >/dev/null; do sleep 30; done
  "$2/bin/hex" restart
  claude agents --json | jq -r --arg home "$1" ".[] | select(.cwd == \$home and .pid) | .sessionId[0:8]" |
    while read -r session; do claude respawn "$session" >/dev/null; done
'
if ! systemd-run --user --collect --quiet --setenv=PATH sh -c "$restart" sh "$home" "$hex" >/dev/null 2>&1; then
  nohup sh -c "$restart" sh "$home" "$hex" >/dev/null 2>&1 &
fi
echo "updated hex $before..$after, channels $(git -C channels rev-parse --short "$current")..$(git -C channels rev-parse --short HEAD); the hub and sessions restart on it as soon as none of them is busy"
