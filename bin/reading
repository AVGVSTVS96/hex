#!/bin/sh
input=$(cat)
[ -n "$(printf '%s' "$input" | jq -r '.agent_id // empty' 2>/dev/null)" ] && exit 0
session=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
[ -n "$session" ] || exit 0
dir=${XDG_RUNTIME_DIR:-/tmp}/hex-reading
mkdir -p "$dir" 2>/dev/null || exit 0
file=$dir/$session
[ "${1:-}" = turn ] && { rm -f "$file"; exit 0; }

size=$(printf '%s' "$input" | jq '.tool_response | tojson | length' 2>/dev/null) || exit 0
total=$(( $(cat "$file" 2>/dev/null || echo 0) + ${size:-0} / 4 ))
echo "$total" > "$file"
jq -n --arg k "$(( (total + 500) / 1000 ))" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext:
  "Reading this turn: \($k)k tokens into your own context. Bassim: \"there'"'"'s a difference between the things that i could get fast responses for and the things that need 50,000 tokens worth of context reads ... those are things that sub-agents should always be used for.\""}}'
exit 0
