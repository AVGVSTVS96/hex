#!/bin/sh
# room [busiest]: prints this machine's readings and exits 0 when it has room for one more agent job: the CPU at most
# busiest% busy over 2 s (50), a fifth of its memory and 25 GB of disk free, and a Mac on power and not slowed by heat.
# Another machine runs it as `ssh <machine> sh -s < room`. Its last line names the machine's hex T3 Code while that runs.
set -u
busiest=${1:-50}
room=0
disk=$(df -Pk "$HOME" | awk 'NR == 2 { print int($4 / 1048576) }')
if [ "$(uname)" = Darwin ]; then
  # Load average counts sleeping simulator threads, so a Mac reads load 800 while half idle; idle time is the signal.
  busy=$(top -l 2 -n 0 -s 2 | awk '/CPU usage/ { idle = $7 } END { print int(100 - idle) }')
  free=$(memory_pressure | awk '/free percentage/ { print int($NF) }')
  power=$(pmset -g batt | grep -q "AC Power" && echo "on power" || echo "on battery")
  heat=$(pmset -g therm | awk -F'= *' '/CPU_Speed_Limit/ && $2 < 100 { hot = 1 } /level set to [1-9]/ { hot = 1 } END { if (hot) print "slowed by heat" }')
  echo "cpu ${busy}% busy, memory ${free}% free, disk ${disk} GB free, $power${heat:+, $heat}"
  [ "$power" = "on power" ] && [ -z "$heat" ] || room=1
else
  # The share of CPU time not idle between two reads of /proc/stat, as T3 Code measures a host. Time spent on niced
  # work counts as idle, since a new job takes that time back.
  stat() { awk '/^cpu / { print $3 + $5 + $6, $2 + $3 + $4 + $5 + $6 + $7 + $8 + $9 }' /proc/stat; }
  before=$(stat)
  sleep 2
  busy=$(stat | awk -v before="$before" '{ split(before, b, " "); print int(100 - 100 * ($1 - b[1]) / ($2 - b[2])) }')
  free=$(awk '/MemTotal/ { t = $2 } /MemAvailable/ { a = $2 } END { print int(100 * a / t) }' /proc/meminfo)
  echo "cpu ${busy}% busy, memory ${free}% free, disk ${disk} GB free"
fi
[ "$busy" -le "$busiest" ] && [ "$free" -ge 20 ] && [ "$disk" -ge 25 ] || room=1
origin=$(sed -n 's/.*"origin":"\([^"]*\)".*/\1/p' "$HOME/.t3-hex/userdata/server-runtime.json" 2>/dev/null)
[ -n "$origin" ] && curl -fsm 3 -o /dev/null "$origin/.well-known/t3/environment" && echo "t3 $(cat "$HOME/.t3-hex/userdata/environment-id")"
exit $room
