#!/bin/sh
# room [<jobs>]: whether this machine has room for another agent: a load under one per core, a fifth of its memory
# free, 25 GB of disk free and, given <jobs>, fewer than that many hex jobs already running on it. Prints what it
# read and exits 0 when there's room. Runs as is on Linux and macOS, so a job checks another machine with
# `ssh <machine> sh -s <jobs> < room`.
cores=$(getconf _NPROCESSORS_ONLN)
if [ -r /proc/loadavg ]; then
  load=$(cut -d ' ' -f 1 /proc/loadavg)
  memory=$(awk '/^MemTotal/{ t = $2 } /^MemAvailable/{ a = $2 } END { print int(a * 100 / t) }' /proc/meminfo)
  jobs=$(pgrep -fc -- '--append-system-prompt-file [^ ]*/\.cache/hex/')
else
  load=$(sysctl -n vm.loadavg | awk '{ print $2 }')
  memory=$(memory_pressure | awk '/free percentage/{ print int($NF) }')
  jobs=$(pgrep -f -- '--append-system-prompt-file [^ ]*/\.cache/hex/' | wc -l | tr -d ' ')
fi
disk=$(df -Pk "$HOME" | awk 'NR == 2 { print int($4 / 1048576) }')
echo "$(hostname -s): load $load on $cores cores, memory ${memory}% free, disk ${disk} GB free, ${jobs} hex jobs"
awk "BEGIN { exit !($load < $cores) }" && [ "$memory" -ge 20 ] && [ "$disk" -ge 25 ] && { [ -z "${1:-}" ] || [ "$jobs" -lt "$1" ]; }
