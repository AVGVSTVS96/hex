#!/bin/sh
# hex's vault is enclave (github.com/AVGVSTVS96/enclave). This adds typing on hex's computer.
set -eu
home=$(cd "$(dirname "$0")/../.." && pwd)
if [ "${1:-}" = run ]; then
  # What `vault run` starts keeps its caller's environment and gets the vault's secrets, but none of .env's:
  # of hex's settings, it gets only the ones enclave reads.
  settings=$(. "$(dirname "$0")/settings" && [ -z "$settings_unread" ] &&
    { export -p | grep -E '^export (HEX_NAME|ENCLAVE_HOME|ENCLAVE_RELAY|ENCLAVE_PASS_CLI)=' || :; }) ||
    { echo "hex couldn't read its settings" >&2; exit 1; }
  eval "$settings"
else
  . "$(dirname "$0")/settings"
fi
export ENCLAVE_FROM="${HEX_NAME:-hex}"

pick() {
  enclave="bunx enclave-link@^0.2.12"
  installed=$(command -v enclave) || return 0
  version=$(enclave --version 2>/dev/null) || version=
  case $version in
  0.2.1[2-9] | 0.2.[2-9][0-9] | 0.2.[1-9][0-9][0-9]) enclave=enclave ;;
  *) echo "hex needs enclave-link 0.2.12 or a later 0.2, and \`$installed --version\` says '${version:-nothing (run it to see why)}': npm install -g enclave-link@^0.2.12 (or bun add -g enclave-link@^0.2.12)" >&2; exit 1 ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
vault ask <name> <field…>      a link to send me; a totp field asks for a 2FA setup key
vault wait <name>              wait for me to fill it in, then save it
vault fill <name> <field>      type a saved value (totp: the current 2FA code) on your computer
vault passkey <name> [field]   let your computer's browser sign in once with a saved passkey, in the next 5 minutes
vault list [search] | run | get | save | rm | import   the same as enclave's
EOF
  exit 2
}

computer() {
  [ -n "${HEX_COMPUTER:-}" ] || { echo "set HEX_COMPUTER in .claude/settings.json's env to your computer's Sprite name" >&2; exit 1; }
}

case ${1:-} in
fill)
  [ $# -eq 3 ] || usage
  computer
  pick
  value=$($enclave get "$2" "$3" && printf .)
  printf %s "${value%.}" |
    sprite exec -s "$HEX_COMPUTER" -- sh -c 'jq -Rsc "{scope: \"desktop\", text: .}" | DISPLAY=:1 ~/.local/bin/cua-driver call type_text >/dev/null'
  echo "typed $2's $3 on $HEX_COMPUTER"
  ;;
ask | wait | passkey | list | run | get | save | rm | import)
  pick
  exec $enclave "$@"
  ;;
*) usage ;;
esac
