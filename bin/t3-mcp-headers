#!/bin/sh
# t3-mcp-headers: prints {"Authorization": "Bearer …"} for this machine's T3 Code /mcp, as a headersHelper does.
# T3's /mcp only takes its own OAuth tokens (30 days, no refresh), so this signs in the way an MCP client
# does, approving with a one-time `t3 auth pairing create` code, and caches the token.
set -eu
cache="$HOME/.claude/channels/hex/t3/mcp-token.json"
now=$(date +%s)
if [ -s "$cache" ] && [ "$(jq -r .expires_at "$cache")" -gt $((now + 86400)) ]; then
  jq -c '{Authorization: ("Bearer " + .access_token)}' "$cache"
  exit
fi
base=http://127.0.0.1:$(jq -r .port "$HOME/.t3/userdata/server-runtime.json")
redirect=http://127.0.0.1:1/callback
client=$(curl -sf "$base/oauth/mcp/register" -H 'content-type: application/json' \
  -d "{\"client_name\":\"hex\",\"redirect_uris\":[\"$redirect\"]}" | jq -r .client_id)
verifier=$(openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n')
challenge=$(printf %s "$verifier" | openssl dgst -sha256 -binary | openssl base64 -A | tr '+/' '-_' | tr -d '=')
code=$("$HOME/.t3/bin/t3" auth pairing create --ttl 5m --label hex-mcp --json 2>/dev/null | jq -r .credential)
auth=$(jq -nc --arg c "$client" --arg r "$redirect" --arg ch "$challenge" --arg res "$base/mcp" \
  '{response_type:"code",client_id:$c,redirect_uri:$r,code_challenge:$ch,code_challenge_method:"S256",state:"hex",resource:$res}')
to=$(curl -sf "$base/oauth/mcp/decision" -H 'content-type: application/json' \
  -d "{\"authorization\":$auth,\"decision\":{\"_tag\":\"pairing-code\",\"access\":\"full-access\",\"code\":\"$code\"}}" | jq -r .redirectTo)
grant=$(printf %s "$to" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')
mkdir -p "$(dirname "$cache")"
curl -sf "$base/oauth/mcp/token" --data-urlencode grant_type=authorization_code \
  --data-urlencode "code=$grant" --data-urlencode "redirect_uri=$redirect" \
  --data-urlencode "client_id=$client" --data-urlencode "code_verifier=$verifier" \
  --data-urlencode "resource=$base/mcp" |
  jq --argjson now "$now" '{access_token, expires_at: ($now + .expires_in)}' >"$cache.tmp"
chmod 600 "$cache.tmp" && mv "$cache.tmp" "$cache"
jq -c '{Authorization: ("Bearer " + .access_token)}' "$cache"
