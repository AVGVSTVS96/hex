#!/bin/sh
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
cd "$hex"
# The update runs inside a hex session, whose HEX_* variables would steer the hooks under test.
unset $(env | sed -n 's/^\(HEX_[A-Z_]*\)=.*/\1/p')
out=$(mktemp -d)
export TMPDIR="$out"
trap 'rm -rf "$out"' EXIT
# Discord's voice (prism-media) requires ffmpeg-static only when it's installed, which a bundle can't tell.
build="bun build --target bun --external ffmpeg-static"
bun install --silent
bunx tsc
jq -e 'all(.plugins[]; .source == "./\(.name)")' channels/.claude-plugin/marketplace.json >/dev/null
for plugin in $(jq -r '.plugins[].name' channels/.claude-plugin/marketplace.json); do
  bunx tsc -p "channels/$plugin"
  $build "channels/$plugin/bot.ts" --outdir "$out/$plugin" >/dev/null
  [ ! -e "channels/$plugin/.mcp.json" ] || jq -e --arg plugin "$plugin" '.mcpServers[$plugin].type == "http"' "channels/$plugin/.mcp.json" >/dev/null
done
$build channels/buzz/provider.ts --outdir "$out/provider" >/dev/null
$build hub/serve.ts --outdir "$out/hub" >/dev/null
# The one time limit on tests, so a test fails on time only when it hangs: on a busy server one that takes a second here took 32.
bun test --isolate --timeout 300000 plugin/tests hub channels
