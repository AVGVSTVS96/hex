#!/bin/sh
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
# Trusting a folder trusts every folder under it, so a session started in the home folder or above it works in the hex folder, and hex never trusts one.
above() { case "$(cd && pwd -P)/" in "$(pwd -P | sed 's:/*$::')/"*) ;; *) return 1 ;; esac; }
above && cd "$home"
here=$(pwd -P)
[ "$here" = "$(cd "$home" && pwd -P)" ] || away=1
# A session started in the background has nobody to accept Claude Code's trust prompt, so hex trusts the folder it starts in.
# Claude Code rewrites this file as it runs, holding the lock directory next to it, so hex takes that lock too, and checks the write until it holds; the copy keeps the file's mode.
config=$(readlink -f "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json")
bg=${1:-}
untrusted() { [ "$bg" = --bg ] && ! above && [ -s "$config" ] && ! jq -e --arg here "$here" '.projects[$here].hasTrustDialogAccepted' "$config" >/dev/null 2>&1; }
for try in 1 2 3 4 5; do
  untrusted || break
  if mkdir "$config.lock" 2>/dev/null; then
    trap 'rm -f "$config.hex.$$"; rmdir "$config.lock" 2>/dev/null' EXIT
    trap 'exit 1' INT TERM
    trusted=$(jq --arg here "$here" '.projects[$here].hasTrustDialogAccepted = true' "$config") && [ -n "$trusted" ] &&
      cp -p "$config" "$config.hex.$$" && printf '%s\n' "$trusted" > "$config.hex.$$" && mv "$config.hex.$$" "$config" || rm -f "$config.hex.$$"
    rmdir "$config.lock"
    trap - EXIT INT TERM
  fi
  sleep 0.2
done
untrusted && echo "hex couldn't mark $here trusted in $config" >&2
# Memory passes keep the wake current; a launch writes it only when there's none yet, and removes it once memory is off.
(. "$hex/bin/settings"; [ -n "$unread" ] || { [ -n "${MEMORY_DIR:-}" ] && [ -s "$home/state/wake/CLAUDE.md" ]; } || "$hex/bin/wake")
# Outside the hex folder, hex's settings come only through --settings.
[ -n "${away:-}" ] && ! printf '%s\n' "$@" | grep -qx -- --settings && set -- --settings '{}' "$@"
for arg; do
  shift
  if [ "${flag:-}" = --settings ]; then
    # The hub hands its settings over as a file, which keeps its token out of the process list.
    file=
    [ -f "$arg" ] && file=$arg && arg=$(cat "$file")
    main=$(printf '%s' "$arg" | jq -r '.env.HEX_MAIN // empty')
    chat=$(printf '%s' "$arg" | jq -r 'select(.env.HEX_FRESH) | .env | "HEX_FRESH=1 HEX_CHANNEL=\(.HEX_CHANNEL) HEX_THREAD=\(.HEX_THREAD)"')
    voice=$(printf '%s' "$arg" | jq -r 'select(.env.HEX_CHANNEL // "" | startswith("plugin:voice@")) | 1')
    # Outside the hex folder its settings don't load, and Claude Code keeps only the last --settings.
    [ -n "${away:-}" ] && arg=$(printf '%s' "$arg" | jq -c --arg home "$home" --argjson hex "$(cat "$home/.claude/settings.json" 2>/dev/null || echo '{}')" '. as $hub | $hex | .permissions.deny |= (. // [] | map(sub("^(?<rule>\\w+)\\(\\./"; "\(.rule)(/\($home)/"))) | . * $hub')
    # A chat turn's system prompt ends with the instruction files, where the cache reads them, so Claude Code skips its own copy.
    # A chat turn lists skills by name only; the Skill tool still loads any of them.
    [ -n "${chat:-}" ] && arg=$(printf '%s' "$arg" | jq -c --argjson files "$("$hex/bin/instructions" paths)" '.claudeMdExcludes += $files | .skillListingBudgetFraction = 0.0001')
    # The caller waits on every turn, so a call runs a fast model. Calls pause mid-call often enough that the 1-hour cache cost less than 5 minutes over past calls.
    [ -n "${voice:-}" ] && arg=$(printf '%s' "$arg" | jq -c '{model: "sonnet", effortLevel: "low"} + . | .env += {CLAUDE_CODE_PROMPT_CACHE_TTL: "1h", CLAUDE_CODE_SILENT_TURN_REMINDER_TEXT: "The caller has heard nothing from you in a while. If there is something to tell them, a finding or a change of plan, tell them in a few words with say."}')
    # Only hex's own settings files are written back; anyone else's goes in as the merged text.
    case $file in "$home/state/"*) (umask 077 && printf '%s\n' "$arg" > "$file.$$" && mv "$file.$$" "$file") && arg=$file ;; esac
  fi
  set -- "$@" "$arg"
  flag=$arg
done
# Claude Code takes auto and bypassPermissions only from user, managed or flag settings, so the hex folder's mode goes as a flag.
mode=$(jq -r '.permissions.defaultMode // empty' "$home/.claude/settings.json" 2>/dev/null)
[ -n "$mode" ] && set -- --permission-mode "$mode" "$@"
# The main session can run a stronger model than the topics and agents it hands work to.
main_model=$(jq -r '.env.HEX_MAIN_MODEL // empty' "$home/.claude/settings.json" 2>/dev/null)
[ -n "${main:-}" ] && [ -n "$main_model" ] && set -- --model "$main_model" "$@"
if [ -n "${chat:-}" ]; then
  # The chat's prompt replaces Claude Code's, which names each background job's own folder and so would end the cache before the view.
  system=$(env $chat "$hex/bin/chat" turn) || exit
  set -- --mcp-config "$(jq -cn --arg chat "$hex/bin/chat" --arg dir "$(dirname "$system")" '{mcpServers: {chat: {command: $chat, args: ["mcp", $dir]}}}')" --system-prompt-file "$system" --add-dir "$(dirname "$system")/tail" --disallowedTools Artifact,AskUserQuestion,EnterWorktree,Workflow,ScheduleWakeup,ReportFindings "$@"
fi
[ -n "${away:-}" ] && set -- --add-dir "$home" --append-system-prompt "$("$hex/bin/identity" "$home")" "$@"
# A DM turn skips the instruction files and a session away from the hex folder never reads them, so HEX.md's import of the wake reaches neither: it goes as a file Claude Code loads at start and after compacting.
[ -n "${away:-}${chat:-}" ] && [ -s "$home/state/wake/CLAUDE.md" ] && set -- --add-dir "$home/state/wake" "$@"
# With several Claude accounts pooled by tokenmaxxing (github.com/anaclumos/tokenmaxxing), each session starts on the one with the most headroom left.
[ -z "${CLAUDE_SECURESTORAGE_CONFIG_DIR+set}" ] && store=$(tokenmaxxing seat $$ 2>/dev/null) && export CLAUDE_SECURESTORAGE_CONFIG_DIR="$store"
export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1
exec claude --plugin-dir "$hex/plugin" "$@"
