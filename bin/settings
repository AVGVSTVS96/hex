# Sourced, with $home set to the hex folder: exports .env, then the env of .claude/settings.json and
# settings.local.json, which win, the way Claude Code gives them to every session. A setting lives
# in a settings file a session can change; .env keeps the secrets. A settings file that's empty
# (mid-write) or doesn't parse sets settings_unread, so a caller can tell that apart from a setting that isn't there.
[ -f "$home/.env" ] && { set -a; . "$home/.env"; set +a; }
settings_unread=
for settings in "$home/.claude/settings.json" "$home/.claude/settings.local.json"; do
  [ -f "$settings" ] || continue
  [ -s "$settings" ] && exports=$(jq -r '.env // {} | to_entries[] | "export \(.key)=\(.value | tostring | @sh)"' "$settings") && eval "$exports" || settings_unread=1
done
# For a caller that has set $hex: rewrites the wake as these settings have it, except when one
# couldn't be read, since memory would look off and the wake be removed.
wake() { [ -n "$settings_unread" ] || "$hex/bin/wake"; }
