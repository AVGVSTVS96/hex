#!/bin/sh
# Runs from bin/update after the merge, as its own process, so a release's migrations run on the update that brings them.
# Each step runs once, in order: state/migrated holds the number of the last one done, as hex.db's user_version does. A new one is the next stepN, and steps counts it.
set -eu
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
done="$home/state/migrated"

steps=8

step1() {
  [ -f "$home/schedules.json" ] || return 0
  prompt=$(jq -r '.memory.prompt // empty' "$home/schedules.json") || return
  [ "$prompt" = 'Nightly memory pass, see "Memory" in .hex/HEX.md' ] || return 0
  jq 'del(.memory)' "$home/schedules.json" > "$home/schedules.json.new" && mv "$home/schedules.json.new" "$home/schedules.json"
}

step2() {
  [ -f "$home/schedules.json" ] || return 0
  prompt=$(jq -r '.heartbeat.prompt // empty' "$home/schedules.json") || return
  [ "$prompt" = 'Hourly check, see "Heartbeat" in .hex/HEX.md' ] || return 0
  jq --slurpfile defaults "$hex/defaults/schedules.json" '.heartbeat.prompt = $defaults[0].heartbeat.prompt' "$home/schedules.json" > "$home/schedules.json.new" && mv "$home/schedules.json.new" "$home/schedules.json"
}

step3() {
  bun "$hex/hub/past.ts" "$home"
}

step4() {
  [ -e "$home/PROACTIVE.md" ] || cp "$hex/defaults/PROACTIVE.md" "$home/PROACTIVE.md"
}

step5() {
  [ -f "$home/schedules.json" ] || return 0
  old=$(cat <<'EOF'
Hourly check: my email if a mail connector is set up, your own inbox if you have one, the background agents and tasks you started, and anything you said you'd follow up on. If something's worth telling me now, message me in General, a line and a link each; if not, answer with exactly `HEARTBEAT_OK`.
EOF
  )
  prompt=$(jq -r '.heartbeat.prompt // empty' "$home/schedules.json") || return
  [ "$prompt" = "$old" ] || [ "$prompt" = 'Hourly check, see "Heartbeat" in .hex/HEX.md' ] || return 0
  jq --slurpfile defaults "$hex/defaults/schedules.json" '.heartbeat.prompt = $defaults[0].heartbeat.prompt' "$home/schedules.json" > "$home/schedules.json.new" && mv "$home/schedules.json.new" "$home/schedules.json"
}

# The blob ids of every SOUL.md that init has seeded: only a copy that is still exactly one of them gets the new one.
step6() {
  [ -f "$home/SOUL.md" ] || return 0
  case $(git hash-object --no-filters "$home/SOUL.md") in
    a456656b478936f8e466863f1a31b26e94248bc5 | 9e2e9b9b8d6f37ac85e369a75b2123b8f76e7e90 | 4ab4ff6c6026d57bd091f0eb3a7f810203b33529) ;;
    *) return 0 ;;
  esac
  cp "$hex/defaults/SOUL.md" "$home/SOUL.md.new" && mv "$home/SOUL.md.new" "$home/SOUL.md"
}

step7() {
  [ -f "$home/.gitignore" ] || return 0
  grep -qx 'scratch/' "$home/.gitignore" && return 0
  { [ ! -s "$home/.gitignore" ] || [ -z "$(tail -c 1 "$home/.gitignore")" ] || echo; echo 'scratch/'; } >> "$home/.gitignore"
}

# An install on hex's own units gets the slice its agents' work runs in.
step8() {
  unit=$(systemctl --user show -P FragmentPath hex.service 2>/dev/null) || return 0
  [ -n "$unit" ] && [ "$(readlink -f "$unit")" = "$hex/systemd/hex.service" ] || return 0
  systemctl --user link "$hex/systemd/hex-work.slice" && systemctl --user daemon-reload
}

n=$(cat "$done" 2>/dev/null) || n=0
case $n in '' | *[!0-9]*) n=0 ;; esac
while [ "$n" -lt "$steps" ]; do
  n=$((n + 1))
  "step$n" || { echo "hex couldn't run migration $n this time; the next update tries it again" >&2; break; }
  echo "$n" > "$done.new" && mv "$done.new" "$done"
done
