#!/usr/bin/env bun
// quiet: returns once no hex session has been busy for a few seconds, as Claude Code's own session
// files say, so an update lands between turns instead of under one. hex starts every session in
// the background, so those are the ones it waits on. A session id given as the argument is the one
// that asked for this wait, which stays busy until its turn ends, so it's left out.
import { mkdirSync, readdirSync, readFileSync, watch } from "node:fs"
import { homedir } from "node:os"
import { join } from "node:path"

const sessions = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), ".claude"), "sessions")
const settle = Number(process.env.HEX_QUIET_MS ?? 10_000)
const asker = process.argv[2]
mkdirSync(sessions, { recursive: true })

type Session = { pid: number; name?: string; sessionId: string; kind?: string; status?: string }

function read(file: string): Session | undefined {
  try {
    return JSON.parse(readFileSync(join(sessions, file), "utf8"))
  } catch {}
}

function alive(pid: number) {
  try {
    return process.kill(pid, 0)
  } catch {
    return false
  }
}

function busy() {
  return readdirSync(sessions)
    .filter((file) => file.endsWith(".json"))
    .map(read)
    .filter((session) => session?.kind === "bg" && session.status === "busy" && session.sessionId !== asker && alive(session.pid))
    .map((session) => session!.name ?? session!.sessionId)
    .sort()
    .join(", ")
}

await new Promise<void>((done) => {
  let told = ""
  let timer: Timer | undefined
  const look = () => {
    const now = busy()
    if (now && now !== told) console.log(`waiting on: ${now}`)
    told = now
    if (now) {
      clearTimeout(timer)
      timer = undefined
    } else timer ??= setTimeout(() => {
      timer = undefined
      if (busy()) look()
      else done()
    }, settle)
  }
  watch(sessions, look)
  look()
})
process.exit(0)
