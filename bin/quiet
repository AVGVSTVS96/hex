#!/usr/bin/env bun
// quiet: returns once no hex thread's session is busy, as Claude Code's own session files say, and
// none has been for a few seconds, so an update lands between turns instead of under one.
import { readdirSync, readFileSync, watch } from "node:fs"
import { homedir } from "node:os"
import { join, resolve } from "node:path"

const state = resolve(import.meta.dir, "../../state")
const sessions = join(process.env.CLAUDE_CONFIG_DIR || join(homedir(), ".claude"), "sessions")
const settle = Number(process.env.HEX_QUIET_MS ?? 10_000)

type Session = { pid: number; sessionId: string; name?: string; status?: string }

function read<T>(file: string): T | undefined {
  try {
    return JSON.parse(readFileSync(file, "utf8"))
  } catch {}
}

function alive(pid: number) {
  try {
    return process.kill(pid, 0)
  } catch {
    return false
  }
}

function busy() {
  const ours = new Set(
    readdirSync(state, { withFileTypes: true })
      .filter((app) => app.isDirectory())
      .flatMap((app) => Object.values(read<Record<string, { session?: string }>>(join(state, app.name, "threads.json")) ?? {}))
      .map((thread) => thread.session),
  )
  return readdirSync(sessions)
    .filter((file) => file.endsWith(".json"))
    .map((file) => read<Session>(join(sessions, file)))
    .filter((session) => session?.status === "busy" && ours.has(session.sessionId) && alive(session.pid))
    .map((session) => session!.name ?? session!.sessionId)
}

await new Promise<void>((done) => {
  let told = ""
  let timer: Timer | undefined
  const look = () => {
    clearTimeout(timer)
    const now = busy().sort().join(", ")
    if (now && now !== told) console.log(`waiting on: ${now}`)
    told = now
    if (!now) timer = setTimeout(() => (busy().length ? look() : done()), settle)
  }
  watch(sessions, look)
  look()
})
process.exit(0)
