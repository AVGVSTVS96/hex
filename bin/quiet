#!/usr/bin/env bun
// quiet: returns once no hex session has been mid-turn for a few seconds, by the records of them
// hub/running.ts reads, so an update lands between turns instead of under one. hex starts every
// session in the background, so those are the ones it waits on. An argument <session id>@<ms> names the session
// that asked for this wait at that time: it's left out for the busy turn it asked from, which only
// ends after the wait, and counts again from its next turn on.
import { mkdirSync, watch } from "node:fs"
import { join } from "node:path"
import { CLAUDE, records, type SessionRecord } from "../hub/running.ts"

const sessions = join(CLAUDE, "sessions")
const settle = Number(process.env.HEX_QUIET_MS ?? 10_000)
const [asker, asked] = (process.argv[2] ?? "").split("@")
const asking = (record: SessionRecord) => record.id === asker && (record.updated ?? Infinity) <= Number(asked)
mkdirSync(sessions, { recursive: true })

function busy() {
  return records()
    .filter((record) => record.kind === "bg" && record.status === "busy" && !asking(record))
    .map((record) => record.name ?? record.id)
    .sort()
    .join(", ")
}

await new Promise<void>((done) => {
  let told = ""
  let timer: Timer | undefined
  const look = () => {
    const now = busy()
    if (now && now !== told) console.log(`waiting on: ${now}`)
    told = now
    if (now) {
      clearTimeout(timer)
      timer = undefined
    } else timer ??= setTimeout(() => {
      timer = undefined
      if (busy()) look()
      else done()
    }, settle)
  }
  watch(sessions, look)
  look()
})
process.exit(0)
