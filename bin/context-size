#!/bin/sh
transcript=$(jq -r '.transcript_path // empty' 2>/dev/null)
[ -r "$transcript" ] || exit 0

jq -c '
  select(.type == "assistant" and .isSidechain != true and .message.model != "<synthetic>")
  | .message.usage | select(.)
  | .input_tokens + .cache_read_input_tokens + .cache_creation_input_tokens
  | select(. > 0)' "$transcript" 2>/dev/null | tail -n 1 | while read -r tokens; do
  echo "Context: $(( (tokens + 500) / 1000 ))k tokens (input + cache read + cache write) of this session's window."
done
exit 0
