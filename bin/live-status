#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime
from functools import cache
from pathlib import Path

home = Path(os.environ.get("CLAUDE_PROJECT_DIR") or Path(__file__).resolve().parents[2])
now = time.time()
day = 24 * 60 * 60


def ago(t):
    m = int((now - t) // 60)
    return f"{m}m ago" if m < 60 else f"{m // 60}h ago" if m < 2880 else f"{m // 1440}d ago"


def capped(items, n):
    return items[:n] + ([f"- +{len(items) - n} more"] if len(items) > n else [])


def git(*args):
    return subprocess.run(["git", "-C", str(home), *args], capture_output=True, text=True).stdout


def branches():
    unmerged = set(git("branch", "--no-merged", "HEAD", "--format=%(refname:short)").split())
    rows = [r.split("\t") for r in git("for-each-ref", "--sort=-committerdate",
                                       "--format=%(refname:short)\t%(committerdate:unix)\t%(subject)",
                                       "refs/heads").splitlines()]
    return [f"- {name} ({ago(int(t))}): {subject[:100]}" for name, t, subject in rows if name in unmerged]


def one_offs():
    try:
        jobs = json.loads((home / "schedules.json").read_text())
    except (OSError, ValueError):
        return []
    upcoming = []
    for name, job in jobs.items():
        at = job.get("at", [])
        for when in [datetime.fromisoformat(a) for a in ([at] if isinstance(at, str) else at)]:
            if when.timestamp() >= now:
                upcoming.append((when, f"- {when:%a %b %-d %-I:%M%p}: {name}"))
        minute, hour, day, month, _ = job.get("cron", "* * * * *").split()
        if not all(f.isdigit() for f in (minute, hour, day, month)):
            continue
        when = datetime(datetime.now().year, int(month), int(day), int(hour), int(minute))
        if when.timestamp() < now:
            when = when.replace(year=when.year + 1)
        upcoming.append((when, f"- {when:%a %b %-d %-I:%M%p}: {name}"))
    return [line for _, line in sorted(upcoming)]


@cache
def read_running():
    try:
        return json.loads(subprocess.run([str(home / ".hex/bin/hex"), "running", "--json"], capture_output=True, text=True, timeout=5, check=True).stdout), None
    except Exception as error:
        return None, error


def running():
    sessions, error = read_running()
    if error:
        raise error
    return sessions


# A session's live status, or blocked while its job waits on the owner.
def state(session):
    return "blocked" if session.get("state") == "blocked" else session.get("status", "?")


def sessions():
    by_state = {}
    for a in sorted(running(), key=lambda a: -a.get("started", 0)):
        if a.get("kind") == "bg" and (a.get("cwd", "") + "/").startswith(f"{home}/"):
            by_state.setdefault(state(a), []).append(a.get("name") or a["id"][:8])
    return [f"- {state} ({len(names)}): " + ", ".join(names[:8]) + (f", +{len(names) - 8} more" if len(names) > 8 else "")
            for state, names in sorted(by_state.items())]


def threads():
    states = {a["id"]: state(a) for a in read_running()[0] or []}
    listed = subprocess.run([str(home / ".hex/bin/hex"), "threads", "--json"], capture_output=True, text=True, timeout=5, check=True).stdout
    open_threads = [thread for thread in json.loads(listed) if thread["open"]]
    sessions = {thread["thread"]: thread.get("session") for thread in open_threads}
    apps = {thread["thread"]: (thread["app"], thread["name"]) for thread in open_threads}
    since = datetime.fromtimestamp(now - day).strftime("%Y-%m-%dT%H:%M")
    printed = subprocess.run([str(home / ".hex/bin/hex"), "log", "--since", since, "--json"], capture_output=True, text=True, timeout=5, check=True).stdout
    last = {}
    for row in json.loads(printed):
        if not (row["from"] == "terminal" and row["author"] == "hex") and "failed" not in row.get("meta", {}):
            last[row["to"]] = row
    rows = []
    for id, row in sorted(last.items(), key=lambda item: item[1]["at"], reverse=True):
        if id not in sessions:
            continue
        app, name = apps[id]
        author, body, at = row["author"], row["body"], row["at"]
        said = " ".join(re.sub(r"[*`]", "", body).split())
        where = ", ".join(filter(None, [app, states.get(sessions[id])]))
        at = datetime.fromisoformat(at.replace("Z", "+00:00")).timestamp()
        rows.append(f"- {name} ({where}, {ago(at)}) {author}: {said[:100]}{'…' if len(said) > 100 else ''}")
    return rows


def section(title, read):
    try:
        lines = read()
    except Exception:
        return ""
    return f"\n\n{title}:\n" + ("\n".join(lines) if lines else "- none")


sys.stdin.read()
sections = "".join([
    section("Unmerged hex branches, newest first", lambda: capped(branches(), 8)),
    section("Upcoming one-off jobs in schedules.json", lambda: capped(one_offs(), 6)),
    section("hex background sessions running, by state (`hex running`)", sessions),
    section("Threads active in the last day, newest first, with their last message (`hex log`)", lambda: capped(threads(), 8)),
])
if sections:
    print(f"Live status, read just now ({datetime.now():%a %b %-d %-I:%M%p}). It's read from real state every session start; "
          f"trust it over any stored 'waiting on' note, and recheck the source before acting.{sections}")
