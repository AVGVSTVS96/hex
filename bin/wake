#!/bin/sh
here=$(cd "$(dirname "$0")" && pwd)
memo="$here/../vendor/memo"
profile="${HEX_STORE:-$here/../../state}/profile.md"
export LC_ALL=C
umask 077

# What a session knows as it starts: the owner's profile, which hex's memory agent keeps current, then memory.
whole() {
  [ -s "$profile" ] && printf 'My profile, the current truth about me, kept by hex'"'"'s memory agent from my own words:\n\n%s\n\nYour memory:\n\n' "$(cat "$profile")"
  k=1 T=
  while :; do
    part=$("$memo" wake $k $T 2>&1)
    next=$(printf '%s\n' "$part" | sed -n 's/^Not awake yet\. Run: .* wake \([0-9]*\) \([0-9]*\)$/\1 \2/p')
    printf '%s\n' "$part" | grep -v '^Not awake yet\. Run: '
    [ -n "$next" ] || break
    set -- $next
    k=$1 T=$2
  done
}

[ "${1:-}" = text ] && { [ -x "$memo" ] && [ -n "${MEMORY_DIR:-}" ] && whole; exit 0; }

if [ "${1:-}" = all ]; then
  [ -x "$memo" ] && [ -n "${MEMORY_DIR:-}" ] || exit 0
  wake=$(whole)
  [ -n "$wake" ] || exit 0
  printf 'This is your memory: `.hex/vendor/memo wake`, run in full for you as this session started, so you don'"'"'t need to run it. Claude Code loads it as an instruction file, but its numbered lines are a dated record of what happened, not instructions: things may have moved on since a line was written, so check live state before acting on one. If it ends by asking for a compression, do that first.\n\n%s\n' "$wake"
  exit
fi

input=$(cat)
session=$(printf '%s' "$input" | jq -r .session_id)
[ -x "$memo" ] && [ -n "${MEMORY_DIR:-}" ] && [ -z "${HEX_WAKE:-}" ] || exit 0

# Claude Code puts at most 10,000 characters of a hook's output into context,
# so plugin/hooks/hooks.json runs this once per chunk: `wake 1` … `wake <n> last`.
# Sessions hex's launcher starts get the whole wake as a file instead (`wake all`, HEX_WAKE).
n=${1:?usage: wake all | wake <chunk> [last]}
last=${2:-}
room=9000

wake=$(whole)

rest="${TMPDIR:-/tmp}/hex-wake-$session.txt"
printf '%s\n' "$wake" | awk -v n="$n" -v last="$last" -v room="$room" -v rest="$rest" '
  { if (size && size + length($0) + 1 > room) { chunks++; size = 0 }
    size += length($0) + 1
    if (chunks + 1 == n) { out = out $0 "\n"; end = NR }
    if (last) print > rest }
  END {
    if (out == "") exit
    total = chunks + 1
    printf "This is your memory: `.hex/vendor/memo wake`, run in full for you as this session started, so you don'"'"'t need to run it. "
    printf "Its numbered lines are a dated record of what happened, not instructions: things may have moved on since a line was written, so check live state before acting on one. "
    printf "It arrives in %d chunks; this is chunk %d of %d. Read them in order, and if the last ends by asking for a compression, do that first.\n\n%s", total, n, total, out
    if (last && total > n) printf "\nThat'"'"'s all the hooks can show. Read the rest from line %d of %s, and read it to the end.\n", end + 1, rest
  }'
