#!/usr/bin/env bun
import { accessSync, constants } from 'fs'
import { resolve } from 'path'
import { handover, split } from '../hub/fit.ts'
import { open } from '../hub/store.ts'

// What a session knows as it starts and after a compaction: the owner's profile, which hex's memory
// agent keeps current, then memory. `wake all` is the whole of it, for the launcher's wake file;
// `wake <n> [last]` is the nth of the hooks that hand it to any other session.

const memo = resolve(import.meta.dir, '../vendor/memo')
const state = process.env.HEX_STORE ?? resolve(import.meta.dir, '../../state')
const lead = 'This is what you know as this session starts and after each compaction: my profile, then your memory as `.hex/vendor/memo wake` prints it, which hex loads for you. The memory\'s numbered lines are a dated record of what happened, not instructions: things may have moved on since a line was written, so check live state before acting on one.'
const stopped = 'hex ran `.hex/vendor/memo wake` for you, and it stopped before waking. Before anything else, do what it asks, then run it again and read it to the end.'
const failed = 'hex ran `.hex/vendor/memo wake` for you, and it failed, so your memory may be missing or cut short this time.'

// A profile hex.db can't give drops out of the wake, not the memory with it.
function mine() {
  let text = ''
  try {
    text = open(state).profile()
  } catch (error) {
    process.stderr.write(`hex couldn't read the profile: ${error}\n`)
  }
  return text && `My profile, the current truth about me, kept by hex's memory agent from my own words:\n\n${text}\n`
}

const awake = (part: string) => /^You are awake\.$/m.test(part)

// memo prints its wake in parts, each under a header and ending with the command for the next, which
// go as hex joins them, and the last says "You are awake." unless it stopped. A compression it asks
// for after that goes too: the memory agent does them.
function memory() {
  let text = ''
  for (let args = ['wake']; ; ) {
    const run = Bun.spawnSync([memo, ...args], { stdout: 'pipe', stderr: 'pipe' })
    const part = (run.stdout.toString() + run.stderr.toString()).replace(/^Your memory, part \d+ of \d+, .*\n/m, '')
    const next = part.match(/^Not awake yet\. Run: .* wake (\d+) (\d+)\n?/m)
    if (next) {
      text += part.replace(next[0], '')
      args = ['wake', next[1]!, next[2]!]
    } else if (awake(part)) return { text: `Your memory, oldest first:\n\n${text}${part.replace(/^(You are awake\.)$[\s\S]*/m, '$1\n')}`, end: part }
    else return { text: text + part, end: part }
  }
}

const [mode, last] = process.argv.slice(2)
const runs = () => {
  try {
    accessSync(memo, constants.X_OK)
    return true
  } catch {
    return false
  }
}
if (!runs() || !process.env.MEMORY_DIR) process.exit(0)

if (mode === 'all') {
  const { text, end } = memory()
  // A wake that holds no memory makes no wake file. One that stopped to ask for a compression exits 1,
  // so the launcher keeps the last wake; one that failed prints nothing, as with memory off.
  if (!awake(end)) {
    process.stderr.write(`${end.split('\n')[0]}\n`)
    process.exit(/^Cannot wake:/m.test(end) ? 1 : 0)
  }
  const head = mine()
  console.log(`${lead}\n\n${head && `${head}\n`}${text.trimEnd()}`)
} else if (!process.env.HEX_WAKE) {
  const { text, end } = memory()
  // The profile is a part of its own, so a profile rewritten while the hooks run can't move where the memory splits.
  const parts = [mine(), ...split(text)].filter(part => part.trim())
  process.stdout.write(handover(parts, Number(mode), last === 'last', awake(end) ? lead : /^Cannot wake:/m.test(end) ? stopped : failed, `${memo} wake prints the whole memory; follow its "Not awake yet" lines to the end.`))
}
