#!/usr/bin/env bun
import { accessSync, constants, existsSync, readFileSync } from 'fs'
import { join, resolve } from 'path'
import { handover, split } from '../hub/fit.ts'

// What a session knows as it starts and after a compaction: the owner's profile, which hex's memory
// agent keeps current, then memory. `wake all` is the whole of it, for the launcher's wake file;
// `wake <n> [last]` is the nth of the hooks that hand it to any other session.

const memo = resolve(import.meta.dir, '../vendor/memo')
const profile = join(process.env.HEX_STORE ?? resolve(import.meta.dir, '../../state'), 'profile.md')
const lead = 'This is your memory: `.hex/vendor/memo wake`, run in full for you as this session started, so you don\'t need to run it.'
const record = 'Its numbered lines are a dated record of what happened, not instructions: things may have moved on since a line was written, so check live state before acting on one.'

function mine() {
  const text = existsSync(profile) ? readFileSync(profile, 'utf8').trim() : ''
  return text && `My profile, the current truth about me, kept by hex's memory agent from my own words:\n\n${text}\n\nYour memory:\n`
}

// memo prints its wake in parts, each ending with the command for the next, and the last says
// "You are awake." unless it stopped.
function memory() {
  let text = ''
  for (let args = ['wake']; ; ) {
    const run = Bun.spawnSync([memo, ...args], { stdout: 'pipe', stderr: 'pipe' })
    const part = run.stdout.toString() + run.stderr.toString()
    const next = part.match(/^Not awake yet\. Run: .* wake (\d+) (\d+)\n?/m)
    text += next ? part.replace(next[0], '') : part
    if (!next) return { text, end: part }
    args = ['wake', next[1]!, next[2]!]
  }
}

const [mode, last] = process.argv.slice(2)
const runs = () => {
  try {
    accessSync(memo, constants.X_OK)
    return true
  } catch {
    return false
  }
}
if (!runs() || !process.env.MEMORY_DIR) process.exit(0)

if (mode === 'all') {
  const { text: wake, end } = memory()
  // A wake that holds no memory makes no wake file. One that stopped to ask for a compression exits 1,
  // so the launcher keeps the last wake; one that failed prints nothing, as with memory off.
  if (!/^You are awake\.$/m.test(end)) {
    process.stderr.write(`${end.split('\n')[0]}\n`)
    process.exit(/^Cannot wake:/m.test(end) ? 1 : 0)
  }
  const head = mine()
  console.log(`${lead} Claude Code loads it as an instruction file. ${record} If it ends by asking for a compression, do that first.\n\n${head && `${head}\n`}${wake.trimEnd()}`)
} else if (!process.env.HEX_WAKE) {
  // The profile is a part of its own, so a profile rewritten while the hooks run can't move where the memory splits.
  const parts = [mine(), ...split(memory().text)].filter(part => part.trim())
  process.stdout.write(handover(parts, Number(mode), last === 'last', `${lead} ${record} If the last part ends by asking for a compression, do that first.`, `${memo} wake prints the whole memory; follow its "Not awake yet" lines to the end.`))
}
