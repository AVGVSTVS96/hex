#!/bin/sh
# t3-relink <machine>: renews this machine's T3 Code link to the hex T3 Code on <machine> (~/.t3-hex), which lasts
# 30 days, with a fresh pairing code from there, and prints when the renewed link ends.
set -eu
machine=${1:?usage: t3-relink <machine>}
remote() { ssh -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=2 "$machine" "$@"; }
linked() { t3 environment list --json | jq -r --arg id "$id" ".[] | select(.environmentId == \$id) | $1"; }

host=$(uname -n)
id=$(remote 'cat ~/.t3-hex/userdata/environment-id')
url=$(linked '.urls[0] // empty')
[ -n "$url" ] || { echo "t3-relink: no link to $machine's hex T3 Code here" >&2; exit 1; }

# The remote side runs as sh whatever its login shell, with the t3 its service runs, or the one on its PATH.
code=$(remote sh -s <<EOF | awk '/^Token:/ { print $2 }'
version=\$(sed -n 's/.*"activeVersion": *"\([^"]*\)".*/\1/p' "\$HOME/.t3-hex/runtime/service-state.json" 2>/dev/null)
t3="\$HOME/.t3-hex/runtime/versions/\$version/t3"
[ -n "\$version" ] && [ -x "\$t3" ] || t3=t3
"\$t3" pair --base-dir "\$HOME/.t3-hex" --label '${host%%.*}'
EOF
)
[ -n "$code" ] || { echo "t3-relink: $machine's hex T3 Code gave no pairing code" >&2; exit 1; }

t3 environment link "$url" --pairing-code "$code" --access full-access >/dev/null
echo "linked to $machine until $(linked .expiresAt)"
