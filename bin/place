#!/bin/sh
# place <name> <claude args...>: an agent job's unit runs this. The job runs here, as a hex session, in one of this
# machine's HEX_SLOTS (12); while every slot is taken it waits its turn, and its owner hears so once. A slot is a lock
# this script holds until its job has ended, a stop included, so a job that ends, however it ends, gives its slot back.
set -u
hex=$(cd "$(dirname "$0")/.." && pwd)
home=$(cd "$hex/.." && pwd)
name=$1
shift
here=$(uname -n)
slots=$(. "$hex/bin/settings" && echo "${HEX_SLOTS:-12}")
dir=${XDG_STATE_HOME:-$HOME/.local/state}/hex/slots
mkdir -p "$dir"
job=
# A stopped job is waited for, so its slot stays taken while it stops.
trap '[ -z "$job" ] || wait "$job"; exit 143' TERM INT
# The job's stdin, which a job started in the background would otherwise lose.
exec 3<&0
exec 9>"$dir/line"
flock 9
told=
while :; do
  slot=1
  while [ "$slot" -le "$slots" ]; do
    exec 7>"$dir/$here.$slot"
    if flock -n 7; then
      flock -u 9
      echo "$name runs on $here"
      "$hex/bin/session" -n "$name" "$@" <&3 3<&- 7>&- 9>&- &
      job=$!
      wait "$job"
      exit
    fi
    exec 7>&-
    slot=$((slot + 1))
  done
  if [ -z "$told" ]; then
    told=1
    echo "$name waits for one of $here's $slots slots"
    [ -z "${HEX_OWNER:-}" ] || bun "$hex/bin/job" --waiting "${name##*/}" "$HEX_OWNER" "$slots"
  fi
  # Out of line while it waits, so the jobs behind it hear they wait too.
  flock -u 9
  sleep 10
  flock 9
done
