{
  "mcpServers": {
    "discord": {
      "type": "http",
      "url": "http://127.0.0.1:${HEX_PORT}/discord",
      "timeout": 300000,
      "headers": {
        "X-Hex-Channel": "${HEX_CHANNEL}",
        "X-Hex-Thread": "${HEX_THREAD}",
        "Authorization": "Bearer ${HEX_TOKEN}"
      }
    }
  }
}
