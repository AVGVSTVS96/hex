{
  "enabledPlugins": {
    "telegram@assistant": true
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/channels/hub/state.ts busy" }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/channels/hub/state.ts idle" },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/bin/log threads" }
      ] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/channels/hub/state.ts idle" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/bin/log threads" }] }
    ]
  }
}
