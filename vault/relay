#!/usr/bin/env bun
import { ConvexClient } from "convex/browser"
import { anyApi as api } from "convex/server"

const client = new ConvexClient(process.env.HEX_VAULT_CONVEX_URL || "https://utmost-toad-923.convex.cloud")
const [command, id] = process.argv.slice(2)

if (command === "open") {
  const secret = Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString("base64url")
  const url = await client.mutation(api.drops.open, { secret })
  console.log(JSON.stringify({ id: secret, url }))
} else if (command === "wait" && id) {
  const sealed = await new Promise<string | null>((resolve) => {
    const stop = client.onUpdate(api.drops.watch, { secret: id }, async (state) => {
      if (state === "open") return
      stop()
      resolve(state === "sealed" ? await client.mutation(api.drops.take, { secret: id }) : null)
    })
  })
  if (sealed) console.log(sealed)
  else process.exitCode = 1
} else if (command === "close" && id) {
  await client.mutation(api.drops.close, { secret: id })
} else {
  console.error("usage: relay open | wait <id> | close <id>")
  process.exitCode = 2
}
await client.close()
