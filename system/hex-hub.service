[Unit]
Description=hex hub: one connection per app, one Claude session per thread

[Service]
WorkingDirectory=%h/hex/channels
EnvironmentFile=%h/hex/.env
Environment=HEX_DIR=%h/hex
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env bun install --no-summary --cwd external_plugins/telegram
ExecStartPre=/usr/bin/env bun install --no-summary --cwd external_plugins/discord
ExecStart=/usr/bin/env bun hub/serve.ts
KillMode=process
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
