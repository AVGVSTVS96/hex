[Unit]
Description=hex: the main assistant session, in Telegram's General topic
Wants=hex-hub.service
After=hex-hub.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/hex/bin/hex
KillMode=process

[Install]
WantedBy=default.target
